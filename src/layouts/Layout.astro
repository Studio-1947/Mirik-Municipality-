---
import '../styles/global.css';
import { meta, contact, sources, emergency } from '../data/site';
import { pages, sections } from '../data/nav';
import GrievanceForm from '../components/GrievanceForm.astro';
import EmergencyDialog from '../components/EmergencyDialog.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${meta.nameEn} | ${meta.legalName}, Darjeeling`,
  description = 'Official website of Mirik Municipality (Mirik Notified Area Authority), Darjeeling, West Bengal: services, notices, projects, grievances and contacts.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const order = ['about', 'administration', 'services', 'notices', 'clean-mirik', 'contact'];
const navPages = order.map((slug) => pages.find((p) => p.slug === slug)!);
const isCurrent = (slug: string) => path === `/${slug}`;
// Contact has no page of its own (src/pages/_contact.astro is parked): its link scrolls to the footer, which is on every page.
const hrefOf = (slug: string) => (slug === 'contact' ? '#contact' : `/${slug}/`);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#1f4d3a" />
    <script is:inline>
      try {
        var l = localStorage.getItem('lang');
        if (l && l !== 'en') { document.documentElement.lang = l; document.documentElement.classList.add('i18n-pending'); }
      } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400..700&family=Noto+Sans+Devanagari:wght@400;500;600;700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${meta.nameEn} home`}>
          <strong>{meta.nameEn}</strong>
        </a>
        <nav class="main" aria-label="Main">
          <ul>
            {navPages.map((n) => (
              <li class={sections[n.slug] ? `has-sub nav-${n.slug}` : undefined}>
                <a href={hrefOf(n.slug)} aria-current={isCurrent(n.slug) ? 'page' : undefined}>{n.label}</a>
                {sections[n.slug] && (
                  <>
                    <button class="chev" type="button" aria-label={`Show sections of ${n.label}`} aria-expanded="false">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                    <ul class="sub">
                      {sections[n.slug].map((x) => <li><a href={`/${n.slug}/${x.href}`}>{x.label}</a></li>)}
                    </ul>
                  </>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <div class="tools">
          <label class="lang"><span class="sr">Language</span>
            <select id="lang" aria-label="Language">
              <option value="en" title="English">EN</option>
              <option value="ne" title="नेपाली">NE</option>
              <option value="bn" title="বাংলা">BN</option>
            </select>
          </label>
          <a class="sos-btn" href="/emergency/" aria-label="Emergency Call" aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
            <span>Emergency Call</span>
          </a>
          <a class="cta-btn" href="/grievance/">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5h8a1.2 1.2 0 0 1 1.2 1.2v5.6a1.2 1.2 0 0 1-1.2 1.2h-3.2l-3 2.8v-2.8H12a1.2 1.2 0 0 1-1.2-1.2V4.7A1.2 1.2 0 0 1 12 3.5z" /><path d="M16 6.3v2.2M16 10v.01" /><circle cx="6.6" cy="14.6" r="2.7" /><path d="M2 22c0-2.9 2-4.7 4.6-4.7s4.6 1.8 4.6 4.7" /></svg>
            <span>Grievance</span>
          </a>
        </div>
        <details class="menu">
          <summary aria-label="Open menu">Menu</summary>
          <ul>
            <li><a href="/">Home</a></li>
            {pages.filter((n) => n.slug !== 'notices' && n.slug !== 'policies').map((n) => (
              <li class={sections[n.slug] ? 'm-has-sub' : undefined}>
                <div class="mrow">
                  <a href={hrefOf(n.slug)} aria-current={isCurrent(n.slug) ? 'page' : undefined}><span class="n">{n.num}</span>{n.label}</a>
                  {sections[n.slug] && (
                    <button class="mchev" type="button" aria-label={`Show sections of ${n.label}`} aria-expanded="false">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                    </button>
                  )}
                </div>
                {sections[n.slug] && (
                  <ul class="msub">
                    {sections[n.slug].map((x) => <li><a href={`/${n.slug}/${x.href}`}>{x.label}</a></li>)}
                  </ul>
                )}
              </li>
            ))}
            <li><a href="/notices/"><span class="n">08</span>Notices</a></li>
            <li><a href="/policies/"><span class="n">09</span>Website policies</a></li>
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <dialog id="grv-dialog" aria-labelledby="grv-title">
      <div class="dlg-card">
        <div class="dlg-head">
          <h2 id="grv-title">Report a problem in your ward</h2>
          <button type="button" class="dlg-close" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
        <p class="dlg-lead">Broken drains, missed garbage collection, water supply, street lights or anything else. Give your ward and location so the office can act quickly.</p>
        <GrievanceForm prefix="m" />
      </div>
    </dialog>

    <EmergencyDialog />

    <nav class="quickbar" aria-label="Quick actions">
      <a href={`tel:${contact.phones[0].tel}`}>Call</a>
      <a href="/services/">Services</a>
      <a href="/grievance/" class="hl">Grievance</a>
      <a href="/emergency/">SOS</a>
    </nav>

    <footer class="site big" id="contact">
      <div class="wrap f-brandrow">
        <div class="f-id">
          <a class="brand foot-brand" href="/"><strong>{meta.nameEn}</strong></a>
          <p>The civic body of the lake town of Mirik, in the Darjeeling hills of West Bengal.</p>
        </div>
        <ul class="f-links" aria-label="Quick links">
          {pages.filter((n) => n.slug !== 'contact').map((n) => <li><a href={`/${n.slug}/`}>{n.label}</a></li>)}
        </ul>
      </div>

      <div class="wrap f-main">
        <div class="f-col f-social-col">
          <h3>Social Media</h3>
          <div class="f-socials">
            <a class="f-social" href={contact.facebook} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-8.2h2.8l.5-3.3h-3.3V8.4c0-.9.4-1.7 1.8-1.7h1.6V3.8c-.3 0-1.3-.2-2.4-.2-2.5 0-4.1 1.5-4.1 4.2v2.7H7.6v3.3h2.8V22z" /></svg>
              <span>Facebook</span>
            </a>
            {contact.instagram ? (
              <a class="f-social" href={contact.instagram} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".6" fill="currentColor" /></svg>
                <span>Instagram</span>
              </a>
            ) : (
              <span class="f-social off" title="Link coming soon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r=".6" fill="currentColor" /></svg>
                <span>Instagram</span>
              </span>
            )}
            {contact.youtube ? (
              <a class="f-social" href={contact.youtube} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="M10 9.2v5.6l5-2.8z" fill="currentColor" /></svg>
                <span>YouTube</span>
              </a>
            ) : (
              <span class="f-social off" title="Link coming soon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4" /><path d="M10 9.2v5.6l5-2.8z" fill="currentColor" /></svg>
                <span>YouTube</span>
              </span>
            )}
          </div>
        </div>

        <div class="f-col f-contact">
          <h3>Address</h3>
          <address class="fc-row">
            <svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" /></svg>
            <div>{contact.address.map((l) => <span>{l}</span>)}</div>
          </address>
          <ul class="fc-list">
            {contact.phones.map((p) => <li class="fc-row"><svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg><a href={`tel:${p.tel}`}>{p.display}</a></li>)}
            <li class="fc-row"><svg class="fic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 6 9-6" /></svg><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          </ul>
          <h3 class="f-sub">Office hours</h3>
          <p>{contact.hours}</p>
        </div>

        <div class="f-col f-help">
          <h3>Emergency Helpline</h3>
          <ul class="f-sos-list">
          {emergency.map((e) => (
            <li>
              <span class="dept">{e.label}</span>
              <b class="num">{e.number}</b>
              <a class="callbtn" href={`tel:${e.number}`} aria-label={`Call ${e.label} ${e.number}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
                <span>Call</span>
              </a>
            </li>
          ))}
        </ul>
        </div>

        <div class="f-col f-grv">
          <a class="f-square" href="/grievance/">
            <h2>Report a problem in your ward</h2>
            <svg class="f-art" viewBox="0 0 140 80" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="34" cy="34" r="12" /><path d="M10 74c0-15 10-24 24-24s24 9 24 24" />
              <path d="M74 14h50a5 5 0 0 1 5 5v24a5 5 0 0 1-5 5h-30l-14 12V48h-6a5 5 0 0 1-5-5V19a5 5 0 0 1 5-5z" />
              <path d="M99 24v11M99 41v.01" />
              <path d="M2 10l6 3M4 22h7M134 6l-3 6M138 30l6 0" opacity=".6" />
            </svg>
            <span class="f-square-btn">Lodge a grievance <span aria-hidden="true">&rarr;</span></span>
          </a>
        </div>
      </div>

      <div class="f-base">
        <div class="wrap base">
          <span>© {year} {meta.nameEn}. Information last updated {meta.lastUpdated}.</span>
          <span class="credit">Designed and Developed by <a href="https://1947.io" target="_blank" rel="noopener">Studio 1947</a></span>
          <details class="sources">
            <summary>Sources</summary>
            <ul>{sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
          </details>
        </div>
      </div>
    </footer>

    <script>
      import { dict } from '../data/i18n';
      import { extra } from '../data/i18n-extra';

      const all: Record<string, [string, string]> = { ...dict, ...extra };
      const norm = (t: string) => t.replace(/\s+/g, ' ').trim();
      const originals = new WeakMap<Node, string>();
      const attrs = ['aria-label', 'placeholder', 'title'];
      const origTitle = document.title;

      function tr(text: string, i: number): string | undefined {
        return all[text]?.[i];
      }
      function apply(lang: string) {
        const i = lang === 'ne' ? 0 : lang === 'bn' ? 1 : -1;
        document.documentElement.lang = lang;
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
        let n: Node | null;
        while ((n = walker.nextNode())) {
          const parent = (n as Text).parentElement;
          if (!parent || ['SCRIPT', 'STYLE'].includes(parent.tagName) || parent.closest('#lang')) continue;
          if (!originals.has(n)) originals.set(n, n.nodeValue ?? '');
          const orig = originals.get(n)!;
          const key = norm(orig);
          const t = i >= 0 ? tr(key, i) : undefined;
          if (t) n.nodeValue = (orig.match(/^\s*/)?.[0] ?? '') + t + (orig.match(/\s*$/)?.[0] ?? '');
          else n.nodeValue = orig;
        }
        document.querySelectorAll<HTMLElement>('[aria-label],[placeholder],[title]').forEach((el) => {
          for (const a of attrs) {
            const dk = `data-orig-${a}`;
            const v = el.getAttribute(a);
            if (v === null) continue;
            if (!el.hasAttribute(dk)) el.setAttribute(dk, v);
            const orig = el.getAttribute(dk)!;
            const t = i >= 0 ? tr(norm(orig), i) : undefined;
            el.setAttribute(a, t ?? orig);
          }
        });
        const tt = i >= 0 ? tr(norm(origTitle), i) : undefined;
        document.title = tt ?? origTitle;
      }

      // Load the script's font first and keep the viewport anchored, so switching language does not make the page jump.
      async function setLang(lang: string) {
        const fam = lang === 'ne' ? 'Noto Sans Devanagari' : lang === 'bn' ? 'Noto Sans Bengali' : null;
        if (fam) {
          const sample = lang === 'ne' ? 'अ' : 'অ';
          await Promise.race([
            Promise.all(['400', '500', '600', '700'].map((w) => document.fonts.load(`${w} 16px "${fam}"`, sample))),
            new Promise((r) => setTimeout(r, 1500)),
          ]);
        }
        const probe = document.elementFromPoint(window.innerWidth / 2, window.innerHeight * 0.3);
        const before = probe?.getBoundingClientRect().top;
        apply(lang);
        if (probe && before !== undefined) {
          const delta = probe.getBoundingClientRect().top - before;
          if (Math.abs(delta) > 1) window.scrollBy({ top: delta, behavior: 'instant' as ScrollBehavior });
        }
      }

      const select = document.getElementById('lang') as HTMLSelectElement | null;
      let saved = 'en';
      try { saved = localStorage.getItem('lang') || 'en'; } catch {}
      if (select) {
        select.value = saved;
        select.addEventListener('change', () => {
          try { localStorage.setItem('lang', select.value); } catch {}
          setLang(select.value);
        });
      }
      const reveal = () => document.documentElement.classList.remove('i18n-pending');
      if (saved !== 'en') setLang(saved).then(reveal, reveal);
      else reveal();

      // Turn the header into a floating glass pill once the page is scrolled.
      const header = document.querySelector('header.site');
      const subnav = document.querySelector('.subnav');
      const onScroll = () => {
        header?.classList.toggle('scrolled', window.scrollY > 40);
        subnav?.classList.toggle('stuck', subnav.getBoundingClientRect().top <= (window.innerWidth <= 760 ? 78 : 86));
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Dropdowns: chevron toggles (touch/keyboard); hover and focus also open them on desktop.
      const closeAll = (except?: Element | null) =>
        document.querySelectorAll('.has-sub.open, .m-has-sub.open').forEach((li) => {
          if (li !== except) {
            li.classList.remove('open');
            li.querySelector('.chev, .mchev')?.setAttribute('aria-expanded', 'false');
          }
        });
      document.querySelectorAll('.chev, .mchev').forEach((btn) =>
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const li = btn.closest('li');
          const open = !li?.classList.contains('open');
          closeAll(open ? li : null);
          li?.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
        })
      );
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.has-sub')) closeAll();
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
      document.querySelectorAll('.sub a').forEach((a) => a.addEventListener('click', () => closeAll()));

      // Grievance form (page and pop-up): posts to the configured endpoint, otherwise opens an email draft.
      document.querySelectorAll<HTMLFormElement>('form.grv:not(.apt)').forEach((form) => {
        const msg = form.querySelector<HTMLElement>('.form-msg');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!msg) return;
          const data = new FormData(form);
          const endpoint = form.dataset.endpoint;
          if (endpoint) {
            try {
              const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
              if (!res.ok) throw new Error(String(res.status));
              form.reset();
              msg.textContent = 'Thank you. Your grievance has been received by the Municipality Office.';
            } catch {
              msg.textContent = 'Sorry, the form could not be sent. Please email or call the office.';
            }
          } else {
            const body = [
              `Name: ${data.get('name')}`, `Phone: ${data.get('phone')}`, `WhatsApp: ${({ same: 'same as phone', none: 'no WhatsApp' } as Record<string, string>)[String(data.get('wa_mode'))] ?? data.get('whatsapp')}`,
              `Ward: ${data.get('ward')}`, `Location / holding no.: ${data.get('location')}`, '',
              String(data.get('description') ?? ''), '', '(Please attach your photo to this email if you have one.)',
            ].join('\n');
            const subject = `Grievance: ${String(data.get('description') ?? '').trim().split('\n')[0]!.slice(0, 60)} (${data.get('ward')})`;
            window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
            msg.textContent = 'Your email app has opened with the grievance filled in. Please press send.';
          }
          msg.classList.add('show');
        });
      });

      // Grievance buttons open the form in a pop-up on the current page instead of navigating.
      const dlg = document.getElementById('grv-dialog') as HTMLDialogElement | null;
      const onGrievancePage = location.pathname.replace(/\/$/, '') === '/grievance';
      if (dlg && !onGrievancePage && typeof dlg.showModal === 'function') {
        const open = () => {
          dlg.querySelector('.form-msg')?.classList.remove('show');
          dlg.showModal();
          document.body.classList.add('dlg-open');
          document.getElementById('m-name')?.focus();
        };
        document.querySelectorAll<HTMLAnchorElement>('a[href="/grievance/"]').forEach((a) =>
          a.addEventListener('click', (e) => {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
            e.preventDefault();
            a.closest('details')?.removeAttribute('open');
            open();
          })
        );
        dlg.querySelector('.dlg-close')?.addEventListener('click', () => dlg.close());
        dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
        dlg.addEventListener('close', () => document.body.classList.remove('dlg-open'));
      }

      // Close mobile menu after choosing a link.
      document.querySelectorAll('.menu a').forEach((a) =>
        a.addEventListener('click', () => a.closest('details')?.removeAttribute('open'))
      );
    </script>
  </body>
</html>
