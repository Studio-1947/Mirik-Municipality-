---
import { contact, wards } from '../data/site';
interface Props { prefix?: string; }
const { prefix = 'g' } = Astro.props;
---
<form class="grv" data-endpoint={contact.grievanceEndpoint} data-email={contact.email} method="post" enctype="multipart/form-data" action={contact.grievanceEndpoint || undefined}>
  <div><label for={`${prefix}-name`}>Full name</label><input id={`${prefix}-name`} name="name" required autocomplete="name" /></div>
  <div><label for={`${prefix}-phone`}>Phone number</label><input id={`${prefix}-phone`} name="phone" required inputmode="numeric" pattern="[0-9]{10}" maxlength="10" autocomplete="tel" /><div class="hint">10 digits</div></div>
  <div><label for={`${prefix}-email`}>Email</label><input id={`${prefix}-email`} name="email" type="email" autocomplete="email" /></div>
  <div>
    <label for={`${prefix}-ward`}>Ward</label>
    <select id={`${prefix}-ward`} name="ward" required>
      <option value="">Select ward</option>
      {wards.map((w) => <option value={`Ward ${w.no}`}>Ward {w.no}</option>)}
    </select>
  </div>
  <div class="full"><label for={`${prefix}-loc`}>Location or holding number</label><input id={`${prefix}-loc`} name="location" required /></div>
  <div class="full"><label for={`${prefix}-sub`}>Subject</label><input id={`${prefix}-sub`} name="subject" required /></div>
  <div class="full"><label for={`${prefix}-desc`}>Describe the problem</label><textarea id={`${prefix}-desc`} name="description" maxlength="300" required></textarea><div class="hint">Up to 300 characters</div></div>
  <div class="full"><label for={`${prefix}-file`}>Photo (optional)</label><input id={`${prefix}-file`} name="attachment" type="file" accept="image/*,.pdf" /></div>
  <button type="submit">Submit grievance</button>
  <p class="form-msg" role="status"></p>
</form>
