---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/project-case-study.css';
import { caseStudies, type CaseStudy } from '../../../data/case-studies';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}
interface Props { cs: CaseStudy; }
const { cs } = Astro.props;

// Icons: Hugeicons free set (Stroke Rounded, MIT), inlined as SVG like the Services page.
const ic: Record<string, string> = {
