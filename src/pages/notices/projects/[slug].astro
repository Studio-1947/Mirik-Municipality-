  calendar: '<path d="M16 2V6M8 2V6"/><path d="M13 4H11C7.22876 4 5.34315 4 4.17157 5.17157C3 6.34315 3 8.22876 3 12V14C3 17.7712 3 19.6569 4.17157 20.8284C5.34315 22 7.22876 22 11 22H13C16.7712 22 18.6569 22 19.8284 20.8284C21 19.6569 21 17.7712 21 14V12C21 8.22876 21 6.34315 19.8284 5.17157C18.6569 4 16.7712 4 13 4Z"/><path d="M3 10H21"/><path d="M12.1258 14H12.0008M12.1258 18H12.0008M7.625 14H7.5M7.625 18H7.5M16.625 14H16.5M12.2508 14C12.2508 14.1381 12.1389 14.25 12.0008 14.25C11.8628 14.25 11.7508 14.1381 11.7508 14C11.7508 13.8619 11.8628 13.75 12.0008 13.75C12.1389 13.75 12.2508 13.8619 12.2508 14ZM12.2508 18C12.2508 18.1381 12.1389 18.25 12.0008 18.25C11.8628 18.25 11.7508 18.1381 11.7508 18C11.7508 17.8619 11.8628 17.75 12.0008 17.75C12.1389 17.75 12.2508 17.8619 12.2508 18ZM7.75 14C7.75 14.1381 7.63807 14.25 7.5 14.25C7.36193 14.25 7.25 14.1381 7.25 14C7.25 13.8619 7.36193 13.75 7.5 13.75C7.63807 13.75 7.75 13.8619 7.75 14ZM7.75 18C7.75 18.1381 7.63807 18.25 7.5 18.25C7.36193 18.25 7.25 18.1381 7.25 18C7.25 17.8619 7.36193 17.75 7.5 17.75C7.63807 17.75 7.75 17.8619 7.75 18ZM16.75 14C16.75 14.1381 16.6381 14.25 16.5 14.25C16.3619 14.25 16.25 14.1381 16.25 14C16.25 13.8619 16.3619 13.75 16.5 13.75C16.6381 13.75 16.75 13.8619 16.75 14Z"/>', // Calendar03Icon
  people: '<path d="M18.4995 20.5C18.2663 17.5685 15.8417 15.2477 12.808 15.0521L11.9995 15C11.7107 15.0076 11.4416 15.0178 11.1877 15.0298C8.18075 15.1723 5.7304 17.5974 5.49951 20.5"/><path d="M15.2495 9.25C15.2495 11.0449 13.7944 12.5 11.9995 12.5C10.2046 12.5 8.74952 11.0449 8.74952 9.25C8.74952 7.45507 10.2046 6 11.9995 6C13.7944 6 15.2495 7.45507 15.2495 9.25Z"/><path d="M5.50249 8.5C5.17908 7.99485 4.99158 7.39432 4.99158 6.75C4.99158 4.95507 6.44665 3.5 8.24157 3.5C8.68752 3.5 9.1125 3.58982 9.49939 3.75235"/><path d="M18.4963 8.5C18.8197 7.99485 19.0072 7.39432 19.0072 6.75C19.0072 4.95507 17.5521 3.5 15.7572 3.5C15.3113 3.5 14.8863 3.58982 14.4994 3.75235"/><path d="M22.0007 17.9996C21.8208 15.7374 19.9995 13.5 17.9995 13"/><path d="M1.99927 17.9996C2.17923 15.7374 4.00049 13.5 6.00049 13"/>', // UserGroupIcon
  news: '<path d="M10.5 8H18.5M10.5 12H13M18.5 12H16M10.5 16H13M18.5 16H16"/><path d="M7 7.5H6C4.11438 7.5 3.17157 7.5 2.58579 8.08579C2 8.67157 2 9.61438 2 11.5V18C2 19.3807 3.11929 20.5 4.5 20.5C5.88071 20.5 7 19.3807 7 18V7.5Z"/><path d="M16 3.5H11C10.07 3.5 9.60504 3.5 9.22354 3.60222C8.18827 3.87962 7.37962 4.68827 7.10222 5.72354C7 6.10504 7 6.57003 7 7.5V18C7 19.3807 5.88071 20.5 4.5 20.5H16C18.8284 20.5 20.2426 20.5 21.1213 19.6213C22 18.7426 22 17.3284 22 14.5V9.5C22 6.67157 22 5.25736 21.1213 4.37868C20.2426 3.5 18.8284 3.5 16 3.5Z"/>', // News01Icon
  info: '<circle cx="12" cy="12" r="10"/><path d="M12 16V12"/><path d="M12.125 8.25H12M12.25 8.25C12.25 8.11193 12.1381 8 12 8C11.8619 8 11.75 8.11193 11.75 8.25C11.75 8.38807 11.8619 8.5 12 8.5C12.1381 8.5 12.25 8.38807 12.25 8.25Z"/>', // InformationCircleIcon
  target: '<path d="M17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7"/><path d="M14 2.20004C13.3538 2.06886 12.6849 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 11.3151 21.9311 10.6462 21.8 10"/><path d="M12.0303 11.9625L16.5832 7.4096M19.7404 4.34462L19.1872 2.35748C19.0853 2.03011 18.6914 1.89965 18.4259 2.11662C16.9898 3.29018 15.4254 4.87091 16.703 7.36419C19.2771 8.56455 20.7466 6.94584 21.8733 5.5853C22.0975 5.3146 21.9623 4.90767 21.6247 4.81005L19.7404 4.34462Z"/>', // Target02Icon
};
// Tone colours reuse existing accents: blue (services cards), lake, alert.
const tones: Record<CaseStudy['tone'], [string, string]> = {
  blue: ['#2f6fd0', '#e3eefc'],
  lake: ['var(--lake)', 'var(--lake-soft)'],
  orange: ['var(--alert)', 'var(--alert-soft)'],
};
const [accent, soft] = tones[cs.tone];
// Sources are numbered in the order listed; facts link to them as [n].
const srcNo = (id?: string) => (id ? cs.sources.findIndex((s) => s.id === id) + 1 : 0);
const ext = (href: string) => /^https?:/.test(href);
const others = caseStudies.filter((o) => o.slug !== cs.slug);
const hasDemo = [cs.facts, cs.scope, cs.progress, cs.timeline].some((list) => list.some((x) => 'demo' in x && x.demo));
const toc = [
  ['overview', 'Overview'],
  ['why', 'Why it matters'],
  ['scope', 'What the project covers'],
  ...(cs.progress.length ? [['progress', 'Progress']] : []),
  ['timeline', 'Timeline'],
  ['you', 'What this means for you'],
  ['sources', 'Sources'],
];
---
<Layout title={`${cs.title} | Mirik Municipality`}>
  <div class={cs.photo ? 'pagehead plain cs-head has-photo' : 'pagehead plain cs-head'} style={`--accent:${accent};--accent-soft:${soft}`}>
    {cs.photo && <img class="cs-head-photo" src={cs.photo.src} alt="" width="1400" height="930" style={`object-position:${cs.photo.pos ?? 'center'}`} />}
    <svg class="cs-head-mark" viewBox="0 0 24 24" aria-hidden="true" set:html={ic[cs.icon]} />
    <div class="wrap ph-in">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> <a href="/notices/">Notices</a> <span>/</span> <a href="/notices/#projects">Projects</a></nav>
      <p class="eyebrow">Case study</p>
      <h1>{cs.title}</h1>
      <p class="lead">{cs.tagline}</p>
      <div class="cs-head-meta">
        <span class="cs-status"><i aria-hidden="true"></i>{cs.status}</span>
        <span class="cs-updated"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.calendar} /><span>Last updated</span> <span>{cs.updated}</span></span>
      </div>
    </div>
  </div>

  <section class="cs-sec" style={`--c:${accent};--c-soft:${soft}`}>
    <div class="wrap">
      <ul class="cs-facts" aria-label="Key figures">
        {cs.facts.map((f) => (
          <li>
            <b>{f.value}</b>
            <span>{f.label}</span>
            {f.demo ? <em class="cs-demo">Demo</em> : f.src && <sup class="cs-ref"><a href={`#src-${srcNo(f.src)}`}>{srcNo(f.src)}</a></sup>}
          </li>
        ))}
      </ul>

      <div class="cs-grid">
        <div class="cs-main">
          <section id="overview" class="cs-block" aria-labelledby="h-overview">
            <h2 id="h-overview">Overview</h2>
            {cs.summary.map((p) => <p class="cs-lede">{p}</p>)}
            {cs.photo && (
              <figure class="cs-figure">
                <img src={cs.photo.src} alt={cs.photo.alt} width="1400" height="930" loading="lazy" />
                <figcaption>
                  <span>{cs.photo.caption}</span>
                  <small><span>Photo</span>: <a href={cs.photo.url} target="_blank" rel="noopener">{cs.photo.credit}</a>, <a href={cs.photo.licenseUrl} target="_blank" rel="noopener">{cs.photo.license}</a>, <span>via Wikimedia Commons</span></small>
                </figcaption>
              </figure>
            )}
            {cs.related && (
              <aside class="cs-related">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.info} />
                <div><strong>{cs.related.title}</strong><p>{cs.related.text}{cs.related.src && <sup class="cs-ref"><a href={`#src-${srcNo(cs.related.src)}`}>{srcNo(cs.related.src)}</a></sup>}</p></div>
              </aside>
            )}
          </section>

          <section id="why" class="cs-block" aria-labelledby="h-why">
            <h2 id="h-why">Why it matters</h2>
            <div class="cs-why">
              {cs.problem.map((p, i) => (
                <article>
                  <span class="cs-why-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3>{p.title}</h3>
                  <p>{p.text}{p.src && <sup class="cs-ref"><a href={`#src-${srcNo(p.src)}`}>{srcNo(p.src)}</a></sup>}</p>
                </article>
              ))}
            </div>
          </section>

          <section id="scope" class="cs-block" aria-labelledby="h-scope">
            <h2 id="h-scope">What the project covers</h2>
            <ul class="cs-scope">
              {cs.scope.map((s) => (
                <li class={s.demo ? 'is-demo' : undefined}>
                  <span class="cs-scope-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.demo ? ic.target : ic.check} /></span>
                  <div>
                    <h3>{s.title}{s.demo && <em class="cs-demo">Demo</em>}</h3>
                    <p>{s.text}{s.src && <sup class="cs-ref"><a href={`#src-${srcNo(s.src)}`}>{srcNo(s.src)}</a></sup>}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>

          {cs.progress.length > 0 && <section id="progress" class="cs-block" aria-labelledby="h-progress">
            <h2 id="h-progress">Progress</h2>
            <div class="cs-progress">
              {cs.progress.map((p) => (
                <div class="cs-bar" style={`--w:${p.value}%`}>
                  <div class="cs-bar-row"><span>{p.label}{p.demo && <em class="cs-demo">Demo</em>}</span><b>{p.value}%</b></div>
                  <div class="cs-bar-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={p.value} aria-label={p.label}><i></i></div>
                  {p.note && <small>{p.note}</small>}
                </div>
              ))}
              {hasDemo && <p class="cs-demo-note"><em class="cs-demo">Demo</em><span>Items marked Demo are examples, not published figures. They will be replaced when the office shares real data.</span></p>}
            </div>
          </section>}

          <section id="timeline" class="cs-block" aria-labelledby="h-timeline">
            <h2 id="h-timeline">Timeline</h2>
            <ol class="cs-timeline">
              {cs.timeline.map((t) => (
                <li class={`is-${t.state}`}>
                  <span class="cs-dot" aria-hidden="true"></span>
                  <div class="cs-t-card">
                    <div class="cs-t-top">
                      <time>{t.date}</time>
                      <span class="cs-t-state">{t.state === 'done' ? 'Done' : t.state === 'now' ? 'Now' : 'Next'}</span>
                      {t.demo && <em class="cs-demo">Demo</em>}
                    </div>
                    <h3>{t.title}</h3>
                    <p>{t.text}{t.src && <sup class="cs-ref"><a href={`#src-${srcNo(t.src)}`}>{srcNo(t.src)}</a></sup>}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          {cs.challenges.length > 0 && (
            <section class="cs-block cs-challenges" aria-labelledby="h-challenges">
              <h2 id="h-challenges"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.alert} />Challenges</h2>
              <ul>
                {cs.challenges.map((c) => (
                  <li><strong>{c.title}</strong><p>{c.text}{c.src && <sup class="cs-ref"><a href={`#src-${srcNo(c.src)}`}>{srcNo(c.src)}</a></sup>}</p></li>
                ))}
              </ul>
            </section>
          )}

          <section id="you" class="cs-block" aria-labelledby="h-you">
            <h2 id="h-you">What this means for you</h2>
            <ul class="cs-you">
              {cs.residents.map((r) => (
                <li>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.check} />
                  <div>
                    <p>{r.text}</p>
                    {r.href && <a href={r.href}><span>{r.cta}</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.arrow} /></a>}
                  </div>
                </li>
              ))}
            </ul>
          </section>

          <section id="sources" class="cs-block" aria-labelledby="h-sources">
            <h2 id="h-sources">Sources</h2>
            <ol class="cs-sources">
              {cs.sources.map((s, i) => (
                <li id={`src-${i + 1}`}>
                  <span class="cs-src-n">{i + 1}</span>
                  <a href={s.url} target={ext(s.url) ? '_blank' : undefined} rel={ext(s.url) ? 'noopener' : undefined}>{s.label}{ext(s.url) && <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.out} />}</a>
                </li>
              ))}
            </ol>
            <p class="cs-src-note">News reports are summarised in our own words. If you find an error, tell the Municipality Office.</p>
          </section>
        </div>

        <aside class="cs-side">
          <nav class="cs-card cs-toc" aria-labelledby="h-toc">
            <p class="cs-side-h" id="h-toc">On this page</p>
            <ul>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
          </nav>
          <div class="cs-card">
            <p class="cs-side-h"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.people} />Who is involved</p>
            <ul class="cs-agencies">
              {cs.agencies.map((a) => <li><strong>{a.name}</strong><span>{a.role}</span></li>)}
            </ul>
          </div>
          <a class="cs-card cs-cta" href="/grievance/">
            <strong>Spotted a problem with this work?</strong>
            <span>Report it with the grievance form.</span>
            <span class="cs-cta-go"><span>Report a problem</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.arrow} /></span>
          </a>
        </aside>
      </div>

      <nav class="cs-more" aria-labelledby="h-more">
        <h2 id="h-more">Other projects</h2>
        <div class="cs-more-grid">
          {others.map((o) => (
            <a class={`cs-more-card tone-${o.tone}`} href={`/notices/projects/${o.slug}/`}>
              <span class="cs-more-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic[o.icon]} /></span>
              <span class="cs-more-t"><strong>{o.title}</strong><span>{o.tagline}</span></span>
              <svg class="cs-more-go" viewBox="0 0 24 24" aria-hidden="true" set:html={ic.arrow} />
            </a>
          ))}
          <a class="cs-more-card cs-back" href="/notices/#projects">
            <span class="cs-more-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ic.back} /></span>
            <span class="cs-more-t"><strong>All projects</strong><span>Back to the Notices page</span></span>
          </a>
        </div>
      </nav>
    </div>
  </section>
</Layout>

<script>
  // Case study: progress bars fill when they scroll into view.
  const bars = document.querySelector<HTMLElement>('.cs-progress');
  if (bars && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    bars.classList.add('cs-anim');
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      bars.classList.add('in');
      io.disconnect();
    }, { threshold: 0.3 });
    io.observe(bars);
  }
</script>
