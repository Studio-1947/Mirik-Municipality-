        <div class="faqx-list">
          {faqs.map((f, i) => (
            <div class="faqx-item">
              <h3 class="faqx-q">
                <button type="button" id={`faq-q-${i}`} aria-expanded="true" aria-controls={`faq-a-${i}`}>
                  <span>{f.q}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} />
                </button>
              </h3>
              <div class="faqx-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
                <div><p>{f.a}</p></div>
