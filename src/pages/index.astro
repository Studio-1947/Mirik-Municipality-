  <section class="alt" id="faq">
    <div class="wrap faqx">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Common questions</h2>
        <p class="lead">Quick answers about applying, paying and getting help.</p>
      </div>
      <div class="faqx-grid">
        <div class="faqx-media">
          <div class="faqx-img-card">
            <img
              src="/images/faqimg.jpg"
              alt="Mirik Municipality FAQ and citizen assistance"
              loading="lazy"
            />
          </div>
          <div class="faqx-help-card">
            <div class="faqx-help-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
            </div>
            <div>
              <p class="faqx-help-title">Need direct assistance?</p>
              <p class="faqx-help-desc">Visit the municipal office at Krishnanagar, Mirik or lodge a grievance online.</p>
              <a href="/grievance/" class="faqx-help-link">
                <span>Submit a grievance</span>
                <span aria-hidden="true">&rarr;</span>
