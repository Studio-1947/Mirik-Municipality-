  <script>
    // Ward selection (map pins, ward buttons, filter) drives the ward details, the demography figures and the map view.
    const wardInfo: Record<string, { loc: string }> = JSON.parse(document.getElementById('ward-data')?.textContent || '{}');
    const demoData = JSON.parse(document.getElementById('demo-data')?.textContent || '{}') as {
      lit: { overall: number; male: number; female: number };
      pops: number[];
      town: { label: string; value: string; sub: string }[];
      wards: Record<string, { total: number; male: number; female: number; households?: number }>;
    };
    const chips = document.querySelectorAll<HTMLButtonElement>('.wchip');
    const pins = document.querySelectorAll<SVGGElement>('#ward-svg .pin');
    const areas = document.querySelectorAll<SVGPathElement>('#ward-svg .warea');
    const filter = null as HTMLSelectElement | null;   // the ward filter is now the button list above
    const chartsEl = document.getElementById('charts');
    const titleEl = document.getElementById('wd-title');
    const locEl = document.getElementById('wd-loc');
    const noteEl = document.getElementById('demo-note');
    const tiles = document.querySelectorAll<HTMLElement>('.dstat');
    const fmt = (n: number) => n.toLocaleString('en-IN');
    const setTile = (i: number, value: string, sub: string) => {
      const t = tiles[i]; if (!t) return;
      t.querySelector('b')!.textContent = value;
      t.querySelector('small')!.textContent = sub;
    };
    const gender = document.getElementById('gender');
    const figsM = document.querySelectorAll<HTMLElement>('#g-figs-m .fig');
    const figsF = document.querySelectorAll<HTMLElement>('#g-figs-f .fig');
    const fill = (list: NodeListOf<HTMLElement>, share: number) => list.forEach((el, i) => el.style.setProperty('--f', String(Math.max(0, Math.min(1, share / 5 - i)))));
    const setFigs = (mShare: number, fShare: number) => { fill(figsM, mShare); fill(figsF, fShare); };
    const townGender = { m: [document.getElementById('g-m-n')!.textContent, document.getElementById('g-m-p')!.textContent], f: [document.getElementById('g-f-n')!.textContent, document.getElementById('g-f-p')!.textContent], mShare: parseFloat(document.getElementById('g-m-p')!.textContent || '0'), fShare: parseFloat(document.getElementById('g-f-p')!.textContent || '0') };
    function setGender(state: { mN: string; mP: string; fN: string; fP: string; mShare: number; fShare: number } | null) {
      gender?.classList.toggle('off', !state);
      const t = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
      if (!state) { t('g-m-n', 'Not published'); t('g-f-n', 'Not published'); t('g-m-p', '\u2014'); t('g-f-p', '\u2014'); setFigs(0, 0); return; }
      t('g-m-n', state.mN); t('g-m-p', state.mP); t('g-f-n', state.fN); t('g-f-p', state.fP);
      setFigs(state.mShare, state.fShare);
    }
    const townState = { mN: townGender.m[0]!, mP: townGender.m[1]!, fN: townGender.f[0]!, fP: townGender.f[1]!, mShare: townGender.mShare, fShare: townGender.fShare };
    const chartOffEl = document.querySelector<HTMLElement>('.chart-off');
    function renderDemo(no: string) {
      const town = demoData.town;
      chartsEl?.classList.remove('off');
      if (no === 'all') {
        town.forEach((x, i) => setTile(i, x.value, x.sub));
        setGender(townState);
        if (noteEl) noteEl.hidden = true;
        const b0 = document.getElementById('demo-badge'); if (b0) b0.textContent = 'Census 2011';
        const s0 = document.getElementById('chart-src'); if (s0) s0.textContent = 'Source: Census of India 2011';
        chartsEl?.classList.remove('dummy');
        drawLit(demoData.lit); drawGrowth(demoData.pops, 8000, 12500, false);
        syncChartOff(false);
        return;
      }
      const badge = document.getElementById('demo-badge');
      const srcEl = document.getElementById('chart-src');
      const w0 = demoData.wards[no];
      const none = 'Not published';
      // tiles: population, men, women, sex ratio, population in 2001, growth, density, households
      if (w0) {
        const w = w0;
        if (badge) badge.textContent = 'Census 2011';
        if (srcEl) srcEl.textContent = 'Source: Census of India 2011';
        setTile(0, fmt(w.total), 'Census 2011');
        setTile(1, fmt(w.male), `${Math.round((w.male / w.total) * 100)}%`);
        setTile(2, fmt(w.female), `${Math.round((w.female / w.total) * 100)}%`);
        setTile(3, fmt(Math.round((w.female / w.male) * 1000)), town[3].sub);
        setTile(4, '\u2014', none); setTile(5, '\u2014', none); setTile(6, '\u2014', none);
        setTile(7, w.households ? fmt(w.households) : '\u2014', w.households ? 'approx.' : none);
        const mS = (w.male / w.total) * 100, fS = (w.female / w.total) * 100;
        setGender({ mN: fmt(w.male), mP: mS.toFixed(1) + '%', fN: fmt(w.female), fP: fS.toFixed(1) + '%', mShare: mS, fShare: fS });
        if (noteEl) noteEl.hidden = true;
      } else {
        // No published ward figures: show clearly labelled dummy numbers, worked out from the ward number so they stay the same each time.
        const idx = Array.from((document.getElementById('ward-select') as HTMLSelectElement).options).findIndex((o) => o.value === no) + 1;
        const seed = (k: number) => { const x = Math.sin(idx * 12.9898 + k * 78.233) * 43758.5453; return x - Math.floor(x); };
        const townTotal = Number(town[0].value.replace(/,/g, ''));
        const total = Math.round((townTotal / 9) * (0.55 + seed(1) * 0.95));
        const mS = 43.5 + seed(2) * 11, male = Math.round((total * mS) / 100), female = total - male, fS = 100 - mS;
        const growth = 4 + seed(3) * 42;
        setTile(0, fmt(total), 'Dummy data');
        setTile(1, fmt(male), `${Math.round(mS)}%`);
        setTile(2, fmt(female), `${Math.round(fS)}%`);
        setTile(3, fmt(Math.round((female / male) * 1000)), 'Dummy data');
        setTile(4, fmt(Math.round(total / (1 + growth / 100))), 'Dummy data');
        setTile(5, growth.toFixed(1) + '%', 'Dummy data');
        setTile(6, fmt(Math.round(total / 0.72)), 'Dummy data');
        setTile(7, fmt(Math.round(total / 4.1)), 'Dummy data');
        setGender({ mN: fmt(male), mP: mS.toFixed(1) + '%', fN: fmt(female), fP: fS.toFixed(1) + '%', mShare: mS, fShare: fS });
        const litAll = 78 + seed(4) * 18, gap = 2 + seed(5) * 6;
        drawLit({ overall: litAll, male: Math.min(99, litAll + gap / 2), female: litAll - gap / 2 });
        const p01 = total / (1 + growth / 100), p91 = p01 / (1 + (seed(6) * 30 - 10) / 100);
        const all3 = [p91, p01, total];
        drawGrowth(all3.map(Math.round), Math.min(...all3) * 0.7, Math.max(...all3) * 1.02, true);
        if (badge) badge.textContent = 'Dummy data';
        if (srcEl) srcEl.textContent = 'Dummy data, not from the Census';
        if (noteEl) noteEl.hidden = false;
      }
      chartsEl?.classList.toggle('dummy', !w0);
      syncChartOff(!w0);
    }
    const townNote = document.getElementById('g-note')?.textContent || '';
    function drawLit(l: { overall: number; male: number; female: number }) {
      document.querySelectorAll<HTMLElement>('.litrow').forEach((row) => {
        const v = l[row.dataset.lit as 'overall' | 'male' | 'female'] ?? l.overall;
        row.querySelector('em')!.textContent = v.toFixed(1) + '%';
        (row.querySelector('.bar i') as HTMLElement).style.width = v + '%';
      });
    }
    function drawGrowth(pops: number[], lo: number, hi: number, dummy: boolean) {
      const xs = [50, 320, 590];
      const pts = pops.map((v, i) => ({ v, x: xs[i]!, y: 108 - ((v - lo) / (hi - lo)) * 80 }));
      const seg = (p: { x: number; y: number }, q: { x: number; y: number }) => { const m = (p.x + (q.x - p.x) / 2).toFixed(1); return `C ${m} ${p.y.toFixed(1)} ${m} ${q.y.toFixed(1)} ${q.x} ${q.y.toFixed(1)}`; };
      const pB = `M ${pts[1]!.x} ${pts[1]!.y.toFixed(1)} ${seg(pts[1]!, pts[2]!)}`;
      document.getElementById('g-pa')?.setAttribute('d', `M ${pts[0]!.x} ${pts[0]!.y.toFixed(1)} ${seg(pts[0]!, pts[1]!)}`);
      document.getElementById('g-pb')?.setAttribute('d', pB);
      document.getElementById('g-area')?.setAttribute('d', `${pB} L ${pts[2]!.x} 108 L ${pts[1]!.x} 108 Z`);
      document.querySelectorAll<SVGGElement>('svg.growth g').forEach((g, i) => {
        const p = pts[i]; if (!p) return;
        g.querySelector('circle')?.setAttribute('cy', p.y.toFixed(1));
        const t = g.querySelector('.gval'); if (t) { t.setAttribute('y', (p.y - 11).toFixed(1)); t.textContent = fmt(p.v) + (i === 0 ? '*' : ''); }
      });
      const ch = (id: string, a: number, b: number) => {
        const el = document.getElementById(id); if (!el) return;
        const c = ((b - a) / a) * 100;
        el.textContent = `${c < 0 ? 'Down' : 'Up'} ${Math.abs(c).toFixed(1)}%`;
        el.setAttribute('class', `gchg ${c < 0 ? 'down' : 'up'}`);
      };
      ch('g-c1', pops[0]!, pops[1]!); ch('g-c2', pops[1]!, pops[2]!);
      const note = document.getElementById('g-note'); if (note) note.textContent = dummy ? 'Dummy data. These ward figures are made up to show how the chart will look.' : townNote;
    }
    // In a ward view only the gender chart has (dummy) figures; the other two charts stay unavailable.
    const activeTab = () => document.querySelector<HTMLElement>('.tabs button[aria-selected="true"]')?.dataset.tab;
    function syncChartOff(isWard = current !== 'all') {
      if (chartOffEl) chartOffEl.hidden = true;
      document.querySelectorAll<HTMLElement>('#tab-literacy, #tab-growth').forEach((p) => p.classList.remove('ward-off'));
    }

    // ---- map: zoom, pan, focus on a ward ----
    const svg = document.getElementById('ward-svg') as SVGSVGElement | null;
    const mapview = document.getElementById('mapview');
    const FULL = { x: 0, y: 0, w: 817, h: 1156 };
    const ASPECT = 1.05;                              // frame height / width
    const HOME = { x: 142, y: 66, w: 400 };           // default view on the town and its nine pins
    const view = { ...HOME, h: HOME.w * ASPECT };
    let anim = 0;
    function apply() {
      if (!svg) return;
      svg.setAttribute('viewBox', `${view.x} ${view.y} ${view.w} ${view.h}`);
      svg.style.setProperty('--u', String(view.w / (svg.getBoundingClientRect().width || FULL.w)));
    }
    function clamp() {
      view.w = Math.max(110, Math.min(FULL.w, view.w));
      view.h = view.w * ASPECT;
      view.x = Math.max(0, Math.min(FULL.w - view.w, view.x));
      view.y = Math.max(0, Math.min(FULL.h - view.h, view.y));
    }
    function animateTo(t: { x: number; y: number; w: number }) {
      cancelAnimationFrame(anim);
      const from = { ...view }, start = performance.now(), dur = 380;
      const tw = Math.max(110, Math.min(FULL.w, t.w));
      const to = { x: t.x, y: t.y, w: tw };
      // No animation when the tab is in the background or the visitor prefers reduced motion: jump straight there.
      if (document.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        view.w = to.w; view.x = to.x; view.y = to.y; clamp(); apply(); return;
      }
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / dur), e = 1 - Math.pow(1 - k, 3);
        view.w = from.w + (to.w - from.w) * e;
        view.x = from.x + (to.x - from.x) * e;
        view.y = from.y + (to.y - from.y) * e;
        clamp(); apply();
        if (k < 1) anim = requestAnimationFrame(step);
      };
      anim = requestAnimationFrame(step);
    }
    function zoomBy(factor: number) {
      const cx = view.x + view.w / 2, cy = view.y + view.h / 2;
      const nw = Math.max(110, Math.min(FULL.w, view.w / factor)), nh = nw * ASPECT;
      animateTo({ x: cx - nw / 2, y: cy - nh / 2, w: nw });
    }
    document.querySelectorAll<HTMLButtonElement>('.mapctl button').forEach((b) =>
      b.addEventListener('click', () => {
        if (b.dataset.z === 'in') zoomBy(1.6);
        else if (b.dataset.z === 'out') zoomBy(1 / 1.6);
        else animateTo({ ...HOME });
      })
    );
    // drag to pan
    let drag: { px: number; py: number; vx: number; vy: number } | null = null;
    svg?.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || (e.target as Element).closest('.pin')) return;   // touch keeps scrolling the page; use the zoom buttons
      cancelAnimationFrame(anim);
      drag = { px: e.clientX, py: e.clientY, vx: view.x, vy: view.y };
      svg.setPointerCapture(e.pointerId);
      svg.classList.add('grabbing');
    });
    svg?.addEventListener('pointermove', (e) => {
      if (!drag || !svg) return;
      const k = view.w / svg.getBoundingClientRect().width;
      view.x = drag.vx - (e.clientX - drag.px) * k;
      view.y = drag.vy - (e.clientY - drag.py) * k;
      clamp(); apply();
    });
    const endDrag = () => { drag = null; svg?.classList.remove('grabbing'); };
    svg?.addEventListener('pointerup', endDrag);
    svg?.addEventListener('pointercancel', endDrag);
    // ctrl or cmd + wheel zooms (a plain wheel keeps scrolling the page)
    svg?.addEventListener('wheel', (e) => {
      if (!(e.ctrlKey || e.metaKey)) return;
      e.preventDefault();
      zoomBy(e.deltaY < 0 ? 1.25 : 1 / 1.25);
    }, { passive: false });
    window.addEventListener('resize', apply);
    apply();

    function focusMap(no: string) {
      pins.forEach((p) => p.classList.toggle('on', p.dataset.no === no));
      areas.forEach((a) => a.classList.toggle('on', a.dataset.no === no));
      if (no === 'all') { animateTo({ ...HOME }); return; }
      const a = Array.from(areas).find((x) => x.dataset.no === no);
      if (!a) return;
      const bx = Number(a.dataset.bx), by = Number(a.dataset.by), bw = Number(a.dataset.bw), bh = Number(a.dataset.bh);
      const w = Math.max(bw * 1.8, (bh * 1.8) / ASPECT, 170), h = w * ASPECT;
      animateTo({ x: bx + bw / 2 - w / 2, y: by + bh / 2 - h / 2, w });
    }

    let current = 'all';
    function pick(no: string) {
      current = no;
      chips.forEach((c) => c.classList.toggle('on', c.dataset.no === no));
      if (filter) filter.value = no;
      const wsel = document.getElementById('ward-select') as HTMLSelectElement | null;
      if (wsel) wsel.value = no === 'all' ? '' : no;
      document.getElementById('wdrop')?.classList.toggle('on', no !== 'all');
      if (titleEl) titleEl.textContent = no === 'all' ? '' : `Ward ${no}`;
      if (locEl) locEl.textContent = no === 'all' ? 'Choose a ward from the list' : (wardInfo[no]?.loc || 'Location to be added');
      renderDemo(no);
      focusMap(no);
    }
    const toggle = (no: string) => pick(current === no ? 'all' : no);
    chips.forEach((c) => c.addEventListener('click', () => (c.dataset.no === 'all' ? pick('all') : toggle(c.dataset.no!))));
    // chart tabs
    document.querySelectorAll<HTMLButtonElement>('.tabs button').forEach((t) =>
      t.addEventListener('click', () => {
        document.querySelectorAll<HTMLButtonElement>('.tabs button').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
        document.querySelectorAll<HTMLElement>('.tabpanel').forEach((p) => { p.hidden = p.id !== `tab-${t.dataset.tab}`; });
        syncChartOff();
      })
    );
    areas.forEach((a) => a.addEventListener('click', () => toggle(a.dataset.no!)));
    pins.forEach((p) => {
      p.addEventListener('click', () => toggle(p.dataset.no!));
      p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(p.dataset.no!); } });
    });
    filter?.addEventListener('change', () => pick(filter.value));
    document.getElementById('ward-select')?.addEventListener('change', (e) => pick((e.target as HTMLSelectElement).value || 'all'));

    // FAQ accordion: one answer open at a time. Without JS every answer stays visible.
    const faqList = document.querySelector<HTMLElement>('.faqx-list');
    if (faqList) {
      const items = Array.from(faqList.querySelectorAll<HTMLElement>('.faqx-item'));
      const setOpen = (item: HTMLElement, open: boolean) => {
        item.classList.toggle('open', open);
        item.querySelector('button')?.setAttribute('aria-expanded', String(open));
      };
      items.forEach((item) => setOpen(item, false));
      faqList.classList.add('faqx-js');
      items.forEach((item) => {
        item.querySelector('button')?.addEventListener('click', () => {
          const open = !item.classList.contains('open');
          items.forEach((other) => setOpen(other, other === item && open));
        });
      });
    }
  </script>
</Layout>
