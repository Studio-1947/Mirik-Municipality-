---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import blockMapRaw from '../assets/mirik-block-map.svg?raw';
import Avatar from '../components/Avatar.astro';
import { notices, facts, body, contact, wards, demographics } from '../data/site';

const quick = [
  { href: '/services/', title: 'Property (Holding) Tax', text: 'Assessment and payment', tone: 'blue', icon: 'home' },
  { href: '/services/', title: 'Birth and Death Registration', text: 'Register and download certificates', tone: 'green', icon: 'doc' },
  { href: '/services/', title: 'Trade Licence', text: 'Apply or renew online', tone: 'orange', icon: 'shop' },
  { href: '/grievance/', title: 'Grievance', text: 'Report a problem in your ward', tone: 'red', icon: 'chat' },
  { href: '/clean-mirik/', title: 'Clean Mirik', text: 'Segregation rules and fines', tone: 'leaf', icon: 'leaf' },
  { href: '/about/#town-guide', title: 'Town Guide', text: 'Places to see, transport, health and schools.', tone: 'violet', icon: 'cam' },
];
const factIcons: Record<string, string> = {
  'Population (2011)': 'M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20M10 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 4.7a3.5 3.5 0 0 1 0 6.6',
  'Area': 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5M9 9h6v6H9z',
  'Elevation': 'M3 20 9.5 8l4 7 2.5-4L21 20z',
  'Wards': 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  'Households': 'M3 11 12 3l9 8v10h-6v-6H9v6H3z',
  'PIN code': 'M4 5h16v14H4zM4 7l8 6 8-6',
  default: 'M12 3v18M3 12h18',
};
const icons: Record<string, string> = {
  home: 'M3 11 12 3l9 8v10h-6v-6H9v6H3z',
  doc: 'M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8',
  shop: 'M3 9l2-5h14l2 5v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0zM5 13v8h14v-8',
  chat: 'M4 4h16v12H9l-5 4z',
  leaf: 'M5 21c0-9 5-15 15-16 0 10-6 15-15 16zM5 21 14 12',
  cam: 'M4 8h4l2-3h4l2 3h4v12H4zM12 17a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
};
const d11 = demographics.census2011, d01 = demographics.census2001;
const fmt = (n: number) => n.toLocaleString('en-IN');
const demo = [
  { label: 'Population', value: fmt(d11.total), sub: 'Census 2011' },
  { label: 'Men', value: fmt(d11.male), sub: `${Math.round((d11.male / d11.total) * 100)}%` },
  { label: 'Women', value: fmt(d11.female), sub: `${Math.round((d11.female / d11.total) * 100)}%` },
  { label: 'Sex ratio', value: fmt(Math.round((d11.female / d11.male) * 1000)), sub: 'females per 1,000 males' },
  { label: 'Population in 2001', value: fmt(d01.total), sub: 'Census 2001' },
  { label: 'Growth 2001 to 2011', value: `${(((d11.total - d01.total) / d01.total) * 100).toFixed(1)}%`, sub: 'in ten years' },
  { label: 'Density', value: fmt(Math.round(d11.total / 6.5)), sub: 'people per km²' },
  { label: 'Households', value: '2,800', sub: 'approx.' },
];
const lit = demographics.literacy;
// Population growth curve: 1991 is worked out from the published 1991 to 2001 growth rate; 2001 and 2011 are census counts.
const pop1991 = Math.round(d01.total / (1 + demographics.growth1991to2001 / 100));
const gpts = [
  { year: 1991, v: pop1991, x: 50 },
  { year: 2001, v: d01.total, x: 320 },
  { year: 2011, v: d11.total, x: 590 },
].map((p) => ({ ...p, y: 108 - ((p.v - 8000) / 4500) * 80 }));
const seg = (p: { x: number; y: number }, q: { x: number; y: number }) => `C ${(p.x + (q.x - p.x) / 2).toFixed(1)} ${p.y.toFixed(1)} ${(p.x + (q.x - p.x) / 2).toFixed(1)} ${q.y.toFixed(1)} ${q.x} ${q.y.toFixed(1)}`;
const pathA = `M ${gpts[0].x} ${gpts[0].y.toFixed(1)} ${seg(gpts[0], gpts[1])}`;
const pathB = `M ${gpts[1].x} ${gpts[1].y.toFixed(1)} ${seg(gpts[1], gpts[2])}`;
const areaB = `${pathB} L ${gpts[2].x} 108 L ${gpts[1].x} 108 Z`;
const growthDown = Math.abs(demographics.growth1991to2001).toFixed(1);
const growthUp = (((d11.total - d01.total) / d01.total) * 100).toFixed(1);
// Gender pictogram: a row of ten figures per gender, filled to that gender's share of the population.
const maleShare = (d11.male / d11.total) * 100, femaleShare = (d11.female / d11.total) * 100;
const figShapes = {
  m: '<circle cx="12" cy="7" r="5" /><rect x="5" y="14" width="14" height="18" rx="5" /><rect x="7" y="29" width="4.2" height="17" rx="2.1" /><rect x="12.8" y="29" width="4.2" height="17" rx="2.1" />',
  f: '<circle cx="12" cy="7" r="5" /><path d="M12 14c3 0 5 1.6 5.6 4.4L21 33H3l3.4-14.6C7 15.6 9 14 12 14z" /><rect x="8.4" y="31" width="3.2" height="15" rx="1.6" /><rect x="12.4" y="31" width="3.2" height="15" rx="1.6" />',
};
// Two rows of 20 figures (men, women): each row is filled to that gender's share of the population, 5% per figure.
const figsRow = (share: number, shape: 'm' | 'f') => Array.from({ length: 20 }, (_, i) => {
  const f = Math.max(0, Math.min(1, share / 5 - i));
  return `<span class="fig" style="--f:${f.toFixed(3)}"><svg viewBox="0 0 24 48" aria-hidden="true">${figShapes[shape]}</svg><svg class="fill" viewBox="0 0 24 48" aria-hidden="true">${figShapes[shape]}</svg></span>`;
}).join('');
// The block map is inlined so ward pins can sit on it and the view can be zoomed.
const pinLayer = '<g id="ward-pins">' + wards.filter((w) => w.pos).map((w) =>
  `<g class="pin" data-no="${w.no}" data-x="${w.pos![0]}" data-y="${w.pos![1]}" transform="translate(${w.pos![0]} ${w.pos![1]})" tabindex="0" role="button" aria-label="Ward ${w.no}"><g class="pin-s"><circle class="pin-ring" r="16" /><circle class="pin-dot" r="10.5" /><text class="pin-t" y="3.6">${w.no}</text></g></g>`
).join('') + '</g>';
// Approximate ward areas: each is the part of the Mirik town outline that lies closest to that ward's pin.
type Pt = [number, number];
const urbanD = blockMapRaw.match(/<path class="urban" d="([^"]+)"/)![1];
const urbanPts: Pt[] = [...urbanD.matchAll(/[ML]\s*([\d.]+),([\d.]+)/g)].map((m) => [Number(m[1]), Number(m[2])]);
const clipHalf = (poly: Pt[], nx: number, ny: number, c: number): Pt[] => {
  const out: Pt[] = [];
  for (let i = 0; i < poly.length; i++) {
    const a = poly[i], b = poly[(i + 1) % poly.length];
    const da = nx * a[0] + ny * a[1] - c, db = nx * b[0] + ny * b[1] - c;
    if (da <= 0) out.push(a);
    if ((da < 0 && db > 0) || (da > 0 && db < 0)) { const t = da / (da - db); out.push([a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t]); }
  }
  return out;
};
const pinned = wards.filter((w) => w.pos);
const areas = pinned.map((w) => {
  let poly = urbanPts;
  for (const o of pinned) {
    if (o === w) continue;
    const nx = o.pos![0] - w.pos![0], ny = o.pos![1] - w.pos![1];
    poly = clipHalf(poly, nx, ny, (nx * (o.pos![0] + w.pos![0]) + ny * (o.pos![1] + w.pos![1])) / 2);
  }
  const xs = poly.map((q) => q[0]), ys = poly.map((q) => q[1]);
  const bx = Math.min(...xs), by = Math.min(...ys), bw = Math.max(...xs) - bx, bh = Math.max(...ys) - by;
  return { no: w.no, d: 'M ' + poly.map((q) => `${q[0].toFixed(1)} ${q[1].toFixed(1)}`).join(' L ') + ' Z', bx, by, bw, bh };
});
const areaLayer = '<g id="ward-areas">' + areas.map((a) => `<path class="warea" data-no="${a.no}" data-bx="${a.bx.toFixed(1)}" data-by="${a.by.toFixed(1)}" data-bw="${a.bw.toFixed(1)}" data-bh="${a.bh.toFixed(1)}" d="${a.d}" />`).join('') + '</g>';
const MAP_ASPECT = 1.05;                       // frame height / width
const HOME = { x: 142, y: 66, w: 400 };         // default view: Mirik town with all nine ward pins close up
const blockMap = blockMapRaw
  .replace(/<svg([^>]*?)\s+width="817"\s+height="1156"/, '<svg id="ward-svg" preserveAspectRatio="xMidYMid slice"$1')
  .replace('viewBox="0 0 817 1156"', `viewBox="${HOME.x} ${HOME.y} ${HOME.w} ${Math.round(HOME.w * MAP_ASPECT)}"`)
  .replace('</svg>', areaLayer + pinLayer + '</svg>');
const explore = [
  { img: 'lake.jpg', title: 'Sumendu Lake', text: 'The lake at the heart of town' },
  { img: 'tea-night.jpg', pos: 'center 62%', title: 'Moon Light Plucking', text: 'Tea pickers under a full moon' },
  { img: 'monastery.jpg', title: 'Bokar Monastery', text: 'Buddhist monastery on the hill' },
  { img: 'garden.jpg', pos: 'left center', title: 'Lakeside gardens', text: 'Flower beds along the lake' },
  // The Helipad, Okayti, Rangbang and Gufa Patal pictures are web images supplied by the site owner: confirm you have the rights to publish them.
  // The Gufa Patal picture is a small web image (about 335 px wide); replace it with a proper photo you have the rights to.
  { img: 'helipad.jpg', pos: 'left center', title: 'Helipad', text: 'The helipad ground' },
  { img: 'okayti.jpg', title: 'Okatey Fatak', text: 'Tea estate hills near Okayti' },
  { img: 'rangbang.jpg', title: 'Rangabang', text: 'River and bridge near Tabakoshi' },
  { img: 'gufapatal.jpg', pos: 'center 70%', title: '26 Se Gufa Patal', text: 'Viewpoint with a flower garden' },
];
const artPaths: Record<string, string> = {
  helipad: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9 8v8M15 8v8M9 12h6',
  gate: 'M4 21V6M20 21V6M4 9h16M4 15h16M9 9v6M15 9v6M2 6h4M18 6h4',
  hills: 'M2 20 8 9l4 6 3-4 7 9zM16 6.5a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4z',
  cave: 'M3 21c0-8 3-14 9-14s9 6 9 14M8 21c0-4 1.5-7 4-7s4 3 4 7M2 21h20',
};
// FAQ. Keep the English text exact: it is the translation key in i18n.ts.
const faqs = [
  { q: 'How do I apply for a trade licence?', a: 'Apply online on the state e-District portal. You register first with your mobile number and an OTP. Renewals are done there too.' },
  { q: 'How do I register a birth or death?', a: 'Use the state Janma-Mrityu Tathya portal. Once the record is registered, you can download the certificate online.' },
  { q: 'Where do I submit a building plan?', a: 'Building plans are submitted and tracked on the state Online Building Permission System (OBPS).' },
  { q: 'How do I apply for a mutation?', a: 'Apply at the Municipality Office. Take your holding number and the papers that show who owns the property.' },
  { q: 'How do I pay holding tax?', a: 'Holding tax is assessed and paid through the Municipality Office. Take your holding number with you.' },
  { q: 'How do I report a problem in my ward?', a: 'Use the Grievance button at the top of any page, or email or call the office. Give your ward and the exact location so the office can act quickly.' },
  { q: 'When is the office open?', a: 'Monday to Friday, 10:00 AM to 5:30 PM. The office is closed on government holidays.' },
  { q: 'Who do I call in an emergency?', a: 'Dial 112 for any emergency. Police is 100, fire is 101 and ambulance is 108. The Emergency page lists more numbers.' },
];
const chevron = '<path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9"/>'; // Hugeicons ArrowDown01Icon
---
<Layout>
  <section class="herox" id="top">
    <img class="herox-bg" src="/images/hero.jpg" alt="" />
    <div class="herox-shade"></div>
    <div class="wrap herox-in">
      <p class="eyebrow-l">Welcome to Mirik Municipality</p>
      <h1>Serving the Heart of the Mirik Hills</h1>
      <p class="herox-lead">Apply for services, report a problem in your ward, read the latest notices and find who to contact at the municipality.</p>
      <div class="btns">
        <a class="btn solid" href="/services/">Citizen Services <span aria-hidden="true">&rarr;</span></a>
        <a class="btn outline" href="/notices/">Latest Notices <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="quick-sec">
    <div class="wrap">
      <div class="quick-card">
        <div class="row-head">
          <div>
            <p class="eyebrow-l dark">Quick services</p>
            <h2>Services you may need</h2>
          </div>
          <a class="more" href="/services/">View all services <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="quick">
          {quick.map((q) => (
            <a class={`q ${q.tone}`} href={q.href}>
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[q.icon]} /></svg></span>
              <strong>{q.title}</strong>
              <span class="t">{q.text}</span>
              <span class="go" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="grv-banner-sec">
    <div class="wrap">
      <div class="grv-full-card">
        <div class="grv-full-head">
          <div class="grv-full-title">
            <span class="grv-full-eyebrow">LIVE GRIEVANCE TRACKER</span>
            <h2>Streetlight repair</h2>
          </div>
          <div class="grv-full-tags">
            <span class="grv-full-tag ward">Ward III</span>
            <span class="grv-full-tag priority">Priority: High</span>
            <span class="grv-full-tag live"><span class="grv-pulse"></span> Active Case</span>
          </div>
        </div>

        <div class="grv-full-grid">
          <div class="grv-full-item">
            <span class="grv-label">Case Reference</span>
            <strong class="grv-val mono">MM-2026-0187</strong>
          </div>
          <div class="grv-full-item">
            <span class="grv-label">Target SLA</span>
            <strong class="grv-val sla">48 Hrs</strong>
          </div>
          <div class="grv-full-item">
            <span class="grv-label">Location / Asset</span>
            <span class="grv-val">Lake Path · Pole #042</span>
          </div>
          <div class="grv-full-item">
            <span class="grv-label">Assigned Unit</span>
            <span class="grv-val">Crew #03 · P. Gurung</span>
          </div>
          <div class="grv-full-item">
            <span class="grv-label">Direct Helpline</span>
            <a class="grv-val link" href="tel:+919832012345">+91 98320 12345</a>
          </div>
          <div class="grv-full-item">
            <span class="grv-label">Token ID</span>
            <strong class="grv-val mono">#8492-MM</strong>
          </div>
        </div>

        <div class="grv-full-footer">
          <div class="grv-status-badge">
            <span class="grv-status-dot"></span>
            <div>
              <strong>Inspection scheduled</strong>
              <p>Field team assigned · 30 September 2026</p>
            </div>
          </div>

          <ol class="grv-full-steps" aria-label="Grievance progress">
            <li class="step-done">
              <span class="s-num">1</span>
              <div class="s-info">
                <strong>28 Sep</strong>
                <span>Submitted</span>
              </div>
            </li>
            <li class="step-active">
              <span class="s-num">2</span>
              <div class="s-info">
                <strong>30 Sep</strong>
                <span>Field visit</span>
              </div>
            </li>
            <li class="step-next">
              <span class="s-num">3</span>
              <div class="s-info">
                <strong>02 Oct</strong>
                <span>Target fix</span>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="glass-sec">
    <div class="wrap">
      <div class="glass-box">
    <div class="about-grid">
      <div class="about-text">
        <p class="eyebrow-l dark">About Mirik</p>
        <h2>The lake town of Mirik</h2>
        <p>The municipality looks after drinking water, sanitation, waste collection, trade licences, building plans and birth and death records for the town around Sumendu Lake. Use this site to find who does what and how to reach them.</p>
        <a class="btn solid dark" href="/about/">Learn more about Mirik <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="about-img"><img src="/images/garden.jpg" alt="Sumendu Lake and the hills of Mirik" /></div>
      <div class="about-notices">
        <div class="nlist">
          {notices.slice(0, 4).map((n, i) => (
            <a class={i === 0 ? 'nrow urgent' : 'nrow'} href="/notices/">
              <span class="nic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8" /></svg></span>
              <span class="nt"><strong>{n.title}</strong><small>{n.date}</small></span>
              <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
            </a>
          ))}
        </div>
      </div>
    </div>

      <div class="stats">
        {facts.map((f) => (
          <div>
            <span class="sico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={factIcons[f.label] ?? factIcons.default} /></svg></span>
            <span class="stxt"><b>{f.value}</b><span>{f.label}</span></span>
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>

  <section class="body-sec" id="body">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="eyebrow-l dark">Our team</p>
          <h2>Mirik Municipality Body</h2>
        </div>
        <a class="more" href="/administration/">Meet the administration <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="bodygrid">
        {body.map((m) => (
          <article class="member" style={`--tone:${m.tone}`}>
            <Avatar name={m.name || m.role} tone={m.tone} blank={!m.name} photo={m.photo} />
            <div class="minfo">
              <h3>{m.name || 'Name to be added'}</h3>
              <p class="role">{m.role}</p>
              {m.note && <p class="mnote">{m.note}</p>}
            </div>
            <div class="mbtns">
              <a class="mbtn" href={`mailto:${contact.email}?subject=${encodeURIComponent('For ' + m.role + (m.name ? ' ' + m.name : ''))}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v14H4zM4 7l8 6 8-6" /></svg>
                <span>Email</span>
              </a>
              <a class="mbtn call" href={`tel:${m.tel ?? contact.phones[0].tel}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>
                <span>Call</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script type="application/json" id="demo-data" set:html={JSON.stringify({ lit, pops: [pop1991, d01.total, d11.total], town: demo, wards: Object.fromEntries(wards.filter((w) => w.demo).map((w) => [w.no, w.demo])) })} />
  <script type="application/json" id="ward-data" set:html={JSON.stringify(Object.fromEntries(wards.map((w) => [w.no, { loc: w.localities }])))} />
  <section class="wardmap-sec" id="ward-map">
    <video class="glass-video" autoplay muted loop playsinline preload="metadata" poster="/videos/wardmap-poster.jpg" aria-hidden="true" tabindex="-1">
      <source src="/videos/wardmap.mp4" type="video/mp4" />
    </video>
    <div class="wrap"><div class="wm-glass">
      <div class="row-head">
        <div>
          <p class="eyebrow-l dark">Ward map</p>
          <h2>Mirik and its nine wards</h2>
        </div>
        <a class="more" href="/administration/#wards">Ward details <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="wardmap">
        <figure class="wm-map">
          <div class="mapview" id="mapview">
            <Fragment set:html={blockMap} />
          </div>
          <div class="mapctl" role="group" aria-label="Map zoom">
              <button type="button" data-z="in" aria-label="Zoom in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>
              <button type="button" data-z="out" aria-label="Zoom out"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14" /></svg></button>
              <button type="button" data-z="reset" aria-label="Reset map"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg></button>
          </div>
          <figcaption>Mirik Block, redrawn from the Disaster Mitigation Map of Mirik Block (NRDMS, Jalpaiguri). Not survey accurate. Ward pins and the coloured ward areas are approximate: each area is the part of Mirik town nearest its pin, until the office confirms real ward boundaries.</figcaption>
        </figure>

        <div class="wm-side">
          <div class="wm-card">
            <!-- 1. Ward selection -->
            <div class="wc-sec">
              <div class="wc-head has-ctrl">
                <h3>Ward selection</h3>
                <div class="wsel">
                  <label class="wdrop" id="wdrop">
                    <span class="sr">Select Wards</span>
                    <select id="ward-select" aria-label="Select Wards">
                      <option value="">All Wards</option>
                      {wards.map((w) => <option value={w.no}>Ward {w.no}</option>)}
                    </select>
                  </label>
                </div>
              </div>
              <div class="wm-detail" aria-live="polite">
                <h4 id="wd-title"></h4>
                <dl class="kv">
                  <dt>Localities</dt><dd id="wd-loc">Choose a ward from the list</dd>
                  <dt>Councillor</dt><dd id="wd-cllr">Election pending</dd>
                </dl>
              </div>
            </div>

            <!-- 2. Key numbers -->
            <div class="wc-sec">
              <div class="wc-head"><h3>Key numbers</h3><span id="demo-badge">Census 2011</span></div>
              <div class="demo-grid">
                {demo.map((x) => (
                  <div class="dstat"><b>{x.value}</b><span>{x.label}</span><small>{x.sub}</small></div>
                ))}
              </div>
              <p class="demo-note" id="demo-note" hidden>Dummy data: ward-wise Census figures are not published, so these numbers are not real.</p>
            </div>

            <!-- 3. Charts with a toggle -->
            <div class="wc-sec wc-charts" id="charts">
              <div class="wc-head has-ctrl">
                <h3>Charts</h3>
                <div class="tabs" role="tablist" aria-label="Choose a chart">
                  <button type="button" role="tab" aria-selected="true" data-tab="gender">Gender</button>
                  <button type="button" role="tab" aria-selected="false" data-tab="literacy">Literacy</button>
                  <button type="button" role="tab" aria-selected="false" data-tab="growth">Population growth</button>
                </div>
              </div>

              <div class="tabstack">
              <div class="tabpanel" id="tab-gender" role="tabpanel">
                <div class="gender" id="gender">
                  <div class="grow2 male">
                    <div class="gl male"><strong>Men</strong><span class="gnum" id="g-m-n">{fmt(d11.male)}</span><em id="g-m-p">{maleShare.toFixed(1)}%</em></div>
                    <div class="gfigs one" id="g-figs-m" set:html={figsRow(maleShare, 'm')}></div>
                  </div>
                  <div class="grow2 female">
                    <div class="gl female"><strong>Women</strong><span class="gnum" id="g-f-n">{fmt(d11.female)}</span><em id="g-f-p">{femaleShare.toFixed(1)}%</em></div>
                    <div class="gfigs one" id="g-figs-f" set:html={figsRow(femaleShare, 'f')}></div>
                  </div>
                  <p class="gender-title">Each figure stands for 5 in every 100 people</p>
                </div>
              </div>

              <div class="tabpanel" id="tab-literacy" role="tabpanel" hidden>
                <p class="gender-title">Share of people aged 7 and over who can read and write</p>
                <div class="litbars">
                  <div class="litrow all" data-lit="all"><div class="litlabel"><strong>Everyone</strong><em>{lit.overall.toFixed(1)}%</em></div><div class="bar"><i style={`width:${lit.overall}%`}></i></div></div>
                  <div class="litrow male" data-lit="male"><div class="litlabel"><strong>Men</strong><em>{lit.male.toFixed(1)}%</em></div><div class="bar"><i style={`width:${lit.male}%`}></i></div></div>
                  <div class="litrow female" data-lit="female"><div class="litlabel"><strong>Women</strong><em>{lit.female.toFixed(1)}%</em></div><div class="bar"><i style={`width:${lit.female}%`}></i></div></div>
                </div>
              </div>

              <div class="tabpanel" id="tab-growth" role="tabpanel" hidden>
                <p class="gender-title">Population of the town at each census</p>
                <svg class="growth" viewBox="0 0 640 146" role="img" aria-label="Population growth curve for 1991, 2001 and 2011">
                  <defs><linearGradient id="gfill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2e8b3e" stop-opacity=".28" /><stop offset="1" stop-color="#2e8b3e" stop-opacity="0" /></linearGradient></defs>
                  <line x1="10" y1="108" x2="630" y2="108" class="gaxis" />
                  <path id="g-area" d={areaB} fill="url(#gfill)" />
                  <path id="g-pa" d={pathA} class="gline dashed" />
                  <path id="g-pb" d={pathB} class="gline" />
                  {gpts.map((p, i) => (
                    <g>
                      <circle cx={p.x} cy={p.y} r="5" class={i === 0 ? 'gdot hollow' : 'gdot'} />
                      <text x={p.x} y={p.y - 11} class="gval">{fmt(p.v)}{i === 0 ? '*' : ''}</text>
                      <text x={p.x} y="126" class="gyear">{p.year}</text>
                    </g>
                  ))}
                  <text id="g-c1" x="185" y="140" class="gchg down">Down {growthDown}%</text>
                  <text id="g-c2" x="455" y="140" class="gchg up">Up {growthUp}%</text>
                </svg>
                <p class="chart-note" id="g-note">* The 1991 figure is worked out from the published 1991 to 2001 growth rate. The 2001 and 2011 figures are census counts.</p>
              </div>

              </div>
              <p class="chart-off" hidden>Ward-wise figures are not published, so charts are not available for a single ward.</p>
              <p class="chart-src" id="chart-src">Source: Census of India 2011</p>
            </div>

            <p class="demo-lang"><strong>Languages:</strong> {demographics.languages}</p>
          </div>
        </div>
      </div>
      <p class="wm-note">Use the plus and minus buttons or drag to move around the map. Ward boundaries are not drawn, and ward-wise population is not published, so the demography shown is for the whole town.</p>
    </div></div>
  </section>

  <section class="explore-sec">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="eyebrow-l dark">Explore Mirik</p>
          <h2>Places around Mirik</h2>
        </div>
        <a class="more" href="/about/#town-guide">Discover more <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="xcards">
        {explore.map((x) => (
          <a class="xcard" href="/about/#town-guide">
            {x.img
              ? <img src={`/images/${x.img}`} alt={x.title} loading="lazy" style={x.pos ? `object-position:${x.pos}` : undefined} />
              : <span class="xart" style={`background:linear-gradient(145deg, ${x.g[0]}, ${x.g[1]})`} aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d={artPaths[x.art]} /></svg></span>}
            <span class="cap"><strong>{x.title}</strong><small>{x.text}</small></span>
