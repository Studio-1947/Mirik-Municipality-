---
import Layout from '../layouts/Layout.astro';
import Avatar from '../components/Avatar.astro';
import { notices, facts, body } from '../data/site';

const quick = [
  { href: '/services/', title: 'Property (Holding) Tax', text: 'Assessment and payment', tone: 'blue', icon: 'home' },
  { href: '/services/', title: 'Birth and Death Registration', text: 'Register and download certificates', tone: 'green', icon: 'doc' },
  { href: '/services/', title: 'Trade Licence', text: 'Apply or renew online', tone: 'orange', icon: 'shop' },
  { href: '/grievance/', title: 'Grievance', text: 'Report a problem in your ward', tone: 'red', icon: 'chat' },
  { href: '/clean-mirik/', title: 'Clean Mirik', text: 'Segregation rules and fines', tone: 'leaf', icon: 'leaf' },
  { href: '/about/#town-guide', title: 'Town Guide', text: 'Places to see, transport, health and schools.', tone: 'violet', icon: 'cam' },
];
const factIcons: Record<string, string> = {
  'Population (2011)': 'M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20M10 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.5 4.7a3.5 3.5 0 0 1 0 6.6',
  'Area': 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5M9 9h6v6H9z',
  'Elevation': 'M3 20 9.5 8l4 7 2.5-4L21 20z',
  'Wards': 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z',
  'Households': 'M3 11 12 3l9 8v10h-6v-6H9v6H3z',
  'PIN code': 'M4 5h16v14H4zM4 7l8 6 8-6',
  default: 'M12 3v18M3 12h18',
};
const icons: Record<string, string> = {
  home: 'M3 11 12 3l9 8v10h-6v-6H9v6H3z',
  doc: 'M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8',
  shop: 'M3 9l2-5h14l2 5v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0zM5 13v8h14v-8',
  chat: 'M4 4h16v12H9l-5 4z',
  leaf: 'M5 21c0-9 5-15 15-16 0 10-6 15-15 16zM5 21 14 12',
  cam: 'M4 8h4l2-3h4l2 3h4v12H4zM12 17a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
};
const explore = [
  { img: 'lake.jpg', title: 'Sumendu Lake', text: 'Serene waters and scenic beauty' },
  { img: 'tea.jpg', title: 'Tea gardens', text: 'Lush green landscapes' },
  { img: 'monastery.jpg', title: 'Bokar Monastery', text: 'A place of peace and spirituality' },
  { img: 'garden.jpg', pos: 'left center', title: 'Local culture', text: 'Vibrant hills and traditions' },
  // No photos yet for these four: shown as illustrated tiles until real pictures are added to public/images/.
  { art: 'helipad', title: 'Helipad', text: 'Photo coming soon', g: ['#2f6f8f', '#12303a'] },
  { art: 'gate', title: 'Okatey Fatak', text: 'Photo coming soon', g: ['#2b7a5a', '#0f3a2a'] },
  { art: 'hills', title: 'Rangabang', text: 'Photo coming soon', g: ['#b07d12', '#4a3308'] },
  { art: 'cave', title: '26 Se Gufa Patal', text: 'Photo coming soon', g: ['#6a4c93', '#2a1c45'] },
];
const artPaths: Record<string, string> = {
  helipad: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9 8v8M15 8v8M9 12h6',
  gate: 'M4 21V6M20 21V6M4 9h16M4 15h16M9 9v6M15 9v6M2 6h4M18 6h4',
  hills: 'M2 20 8 9l4 6 3-4 7 9zM16 6.5a1.7 1.7 0 1 0 0-3.4 1.7 1.7 0 0 0 0 3.4z',
  cave: 'M3 21c0-8 3-14 9-14s9 6 9 14M8 21c0-4 1.5-7 4-7s4 3 4 7M2 21h20',
};
---
<Layout>
  <section class="herox" id="top">
    <img class="herox-bg" src="/images/hero.jpg" alt="" />
    <div class="herox-shade"></div>
    <div class="wrap herox-in">
      <p class="eyebrow-l">Welcome to Mirik Municipality</p>
      <h1>Serving the Heart of the Hills</h1>
      <p class="herox-lead">Civic services, community development and a cleaner, greener Mirik for a brighter tomorrow, together with our people, in harmony with nature.</p>
      <div class="btns">
        <a class="btn solid" href="/services/">Citizen Services <span aria-hidden="true">&rarr;</span></a>
        <a class="btn outline" href="/notices/">Latest Notices <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="quick-sec">
    <div class="wrap">
      <div class="quick-card">
        <div class="row-head">
          <div>
            <p class="eyebrow-l dark">Quick services</p>
            <h2>Access essential municipal services</h2>
          </div>
          <a class="more" href="/services/">View all services <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="quick">
          {quick.map((q) => (
            <a class={`q ${q.tone}`} href={q.href}>
              <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[q.icon]} /></svg></span>
              <strong>{q.title}</strong>
              <span class="t">{q.text}</span>
              <span class="go" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="glass-sec">
    <video class="glass-video" autoplay muted loop playsinline preload="metadata" poster="/videos/clouds-poster.jpg" aria-hidden="true" tabindex="-1">
      <source src="/videos/clouds.mp4" type="video/mp4" />
    </video>
    <div class="wrap">
      <div class="glass-box">
    <div class="about-grid">
      <div class="about-text">
        <p class="eyebrow-l dark">About Mirik</p>
        <h2>A Town of Natural Beauty and Stronger Communities</h2>
        <p>Mirik Municipality is committed to transparent, people-centric civic services while preserving the town's unique natural beauty. Together, we work towards a cleaner, greener and more inclusive Mirik.</p>
        <a class="btn solid dark" href="/about/">Learn more about Mirik <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="about-img"><img src="/images/garden.jpg" alt="Sumendu Lake and the hills of Mirik" loading="lazy" /></div>
      <div class="about-notices">
        <div class="row-head">
          <p class="eyebrow-l dark">Latest notices</p>
          <a class="more" href="/notices/">View all notices <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="nlist">
          {notices.slice(0, 3).map((n, i) => (
            <a class={i === 0 ? 'nrow urgent' : 'nrow'} href="/notices/">
              <span class="nic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v15H6zM14 2v6h6M9 13h8M9 17h8" /></svg></span>
              <span class="nt"><strong>{n.title}</strong><small>{n.date}</small></span>
              <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg></span>
            </a>
          ))}
        </div>
      </div>
    </div>

      <div class="stats">
        {facts.map((f) => (
          <div>
            <span class="sico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={factIcons[f.label] ?? factIcons.default} /></svg></span>
            <span class="stxt"><b>{f.value}</b><span>{f.label}</span></span>
          </div>
        ))}
      </div>
      </div>
    </div>
  </section>

  <section class="body-sec" id="body">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="eyebrow-l dark">Our team</p>
          <h2>Mirik Municipality Body</h2>
        </div>
        <a class="more" href="/administration/">Meet the administration <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="bodygrid">
        {body.map((m) => (
          <article class="member" style={`--tone:${m.tone}`}>
            <Avatar name={m.name || m.role} tone={m.tone} blank={!m.name} />
            <h3>{m.name || 'Name to be added'}</h3>
            <p class="role">{m.role}</p>
            {m.note && <p class="mnote">{m.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="explore-sec">
    <div class="wrap">
      <div class="row-head">
        <div>
          <p class="eyebrow-l dark">Explore Mirik</p>
          <h2>Nature, Culture and Community</h2>
        </div>
        <a class="more" href="/about/#town-guide">Discover more <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="xcards">
        {explore.map((x) => (
          <a class="xcard" href="/about/#town-guide">
            {x.img
              ? <img src={`/images/${x.img}`} alt={x.title} loading="lazy" style={x.pos ? `object-position:${x.pos}` : undefined} />
              : <span class="xart" style={`background:linear-gradient(145deg, ${x.g[0]}, ${x.g[1]})`} aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d={artPaths[x.art]} /></svg></span>}
            <span class="cap"><strong>{x.title}</strong><small>{x.text}</small></span>
            <span class="go" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
