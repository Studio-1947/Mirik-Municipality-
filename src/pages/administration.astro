---
import Layout from '../layouts/Layout.astro';
import '../styles/administration.css';
import PageHead from '../components/PageHead.astro';
import Avatar from '../components/Avatar.astro';
import AppointmentDialog from '../components/AppointmentDialog.astro';
import blockMapRaw from '../assets/mirik-block-map.svg?raw';
import { meta, contact, administration, offices, body, wards, demographics } from '../data/site';

const fmt = (n: number) => n.toLocaleString('en-IN');
const census = demographics.census2011;
const pinLayer = '<g id="ward-pins">' + wards.filter((w) => w.pos).map((w) =>
  `<g class="pin" data-no="${w.no}" transform="translate(${w.pos![0]} ${w.pos![1]})" tabindex="0" role="button" aria-label="Ward ${w.no}"><g class="pin-s"><circle class="pin-ring" r="16" /><circle class="pin-dot" r="10.5" /><text class="pin-t" y="3.6">${w.no}</text></g></g>`
).join('') + '</g>';
const wardMap = blockMapRaw
  .replace(/<svg([^>]*?)\s+width="817"\s+height="1156"/, '<svg id="ward-svg" preserveAspectRatio="xMidYMid slice"$1')
  .replace('viewBox="0 0 817 1156"', 'viewBox="142 66 400 420"')
  .replace('</svg>', pinLayer + '</svg>');

---
<Layout title="Who runs the municipality | Mirik Municipality">
  <PageHead slug="administration" title="Who runs the municipality" lead="Who is in charge, how the nine wards are set up, and the government offices in town." />
    <section id="administration">
      <div class="wrap">
        <article class="featured" id="administrator">
          <div class="f-photo"><img src={administration.administrator.photoLarge} alt={administration.administrator.name} width="900" height="900" /></div>
          <div class="f-text">
            <p class="eyebrow">Administrator</p>
            <h2>{administration.administrator.name}</h2>
            <p class="f-role">Sub-Divisional Officer, Mirik</p>
            <p class="f-lead">{administration.administrator.name}, is the Sub-Divisional Officer (SDO) of Mirik and, since 19 May 2026, the Administrator of the Mirik Notified Area Authority, running the civic body until a new board is elected. The Sub-Divisional Office is near Mirik Police Station, Thana Line, and is open {contact.hours}.</p>
            <h3 class="f-h">What the Administrator does</h3>
            <ul class="f-list">
              <li>Leads the authority while no elected board is in place</li>
              <li>Oversees the work of the Executive Officer and the Finance Officer</li>
              <li>Decides on works, budgets and civic services for the nine wards</li>
              <li>Also heads the Sub-Divisional Office, Mirik, which became a subdivision on 30 March 2017</li>
            </ul>
            <div class="f-btns">
              <a class="fbtn appt" data-open-apt href={`mailto:${contact.email}?subject=${encodeURIComponent('Appointment request: Administrator, Mirik')}&body=${encodeURIComponent('Name:\nPhone:\nPurpose of the meeting:\nPreferred date and time:\n')}`}>Book an appointment <svg class="fbtn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
              <a class="fbtn" href={`mailto:${contact.email}?subject=${encodeURIComponent('For the Administrator, Mirik')}`}>Email</a>
            </div>
          </div>
        </article>

        <div class="status">
          <span class="dot"></span>
          <div><strong>{administration.status}.</strong> {administration.statusNote}</div>
        </div>
        <section class="admin-body" id="officers" aria-labelledby="body-title">
          <div class="admin-body-head">
            <div>
              <p class="eyebrow">Administration</p>
              <h2 id="body-title">Mirik Municipality Body</h2>
            </div>
            <p>Meet the officers and staff contacts currently listed for the Municipality Office.</p>
          </div>
          <div class="bodygrid">
            {body.filter((member) => member.name).map((member) => (
              <article class="member" style={`--tone:${member.tone}`}>
                <Avatar name={member.name} tone={member.tone} photo={member.photo} />
                <div class="minfo">
                  <h3>{member.name}</h3>
                  <p class="role">{member.role}</p>
                  {member.note && <p class="mnote">{member.note}</p>}
                </div>
                <div class="mbtns">
                  <a class="mbtn" href={`mailto:${contact.email}?subject=${encodeURIComponent('For ' + member.role + ' ' + member.name)}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v14H4zM4 7l8 6 8-6" /></svg><span>Email</span>
                  </a>
                  <a class="mbtn call" href={`tel:${member.tel ?? contact.phones[0].tel}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg><span>Call</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="admin-ward-map" id="jurisdiction" aria-labelledby="ward-map-title">
          <div class="row-head">
            <div><p class="eyebrow">Ward map</p><h2 id="ward-map-title">Mirik and its nine wards</h2></div>
            <a class="more" href="/administration/#offices">Public offices <span aria-hidden="true">&rarr;</span></a>
          </div>
          <div class="wardmap">
            <figure class="wm-map">
              <div class="mapview"><Fragment set:html={wardMap} /></div>
              <figcaption>Select a ward marker to view its locality information. Ward boundaries and pins are approximate.</figcaption>
            </figure>
            <div class="wm-side">
              <div class="wm-card">
                <div class="wc-sec"><div class="wc-head"><h3>Ward selection</h3><span>9 wards</span></div>
                  <div class="ward-localities" aria-live="polite"><strong id="ward-title">All wards</strong><p id="ward-locality">Choose a ward marker on the map to see the available locality information.</p></div>
                </div>
                <div class="wc-sec"><div class="wc-head"><h3>Key numbers</h3><span>Census 2011</span></div>
                  <div class="demo-grid">
                    <div class="dstat"><b>{fmt(census.total)}</b><span>Population</span><small>Census 2011</small></div><div class="dstat"><b>{fmt(census.male)}</b><span>Men</span><small>49%</small></div><div class="dstat"><b>{fmt(census.female)}</b><span>Women</span><small>51%</small></div><div class="dstat"><b>1,024</b><span>Sex ratio</span><small>females per 1,000 males</small></div>
                  </div>
                </div>
                <div class="wc-sec jurisdiction-summary"><div class="wc-head"><h3>Jurisdiction</h3></div>
                  <dl class="kv"><dt>Body</dt><dd>{meta.legalName}</dd><dt>Subdivision</dt><dd>{administration.subdivision}</dd><dt>District</dt><dd>{meta.district}, {meta.state}</dd><dt>Assembly seat</dt><dd>{administration.assembly}</dd></dl>
                </div>
              </div>
            </div>
          </div>
        </section>
        <section class="office-directory" aria-labelledby="offices">
          <div class="office-directory-head">
            <p class="eyebrow">Public offices</p>
            <h2 id="offices">Other government offices in Mirik</h2>
          </div>
          <ul class="offices">
            {offices.map((o) => (
              <li>
                <div class="thumb">
                  {o.photo
                    ? <img src={o.photo} alt={`View around ${o.name}, Mirik`} width="800" height="600" loading="lazy" />
                    : <iframe title={`Map: ${o.name}`} src={`https://www.google.com/maps?q=${encodeURIComponent(o.name + ', ' + o.address)}&z=16&output=embed`} loading="lazy" tabindex="-1" referrerpolicy="no-referrer-when-downgrade"></iframe>}
                </div>
                <div class="obody">
                  <strong>{o.name}</strong>
                  <small>{o.detail}</small>
                  <address>{o.address}</address>
                  <a class="dir" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(o.name + ', ' + o.address)}`} target="_blank" rel="noopener">Directions <span class="direction-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path class="direction-icon-frame" d="m12 2.6 9.4 9.4-9.4 9.4L2.6 12 12 2.6Z" /><path class="direction-icon-turn" d="M8.6 18v-7h6V7l5 5-5 5v-4h-3.8v5H8.6Z" /></svg></span></a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
  <AppointmentDialog />
  <script define:vars={{ wards }}>
    const title = document.getElementById('ward-title');
    const locality = document.getElementById('ward-locality');
    document.querySelectorAll('.pin').forEach((pin) => pin.addEventListener('click', () => {
      const ward = wards.find((item) => item.no === pin.dataset.no);
      if (!ward || !title || !locality) return;
      document.querySelectorAll('.pin').forEach((item) => item.classList.toggle('on', item === pin));
      title.textContent = `Ward ${ward.no}`;
      locality.textContent = ward.localities || 'Locality details will be added when confirmed by the Municipality.';
    }));
  </script>
</Layout>
