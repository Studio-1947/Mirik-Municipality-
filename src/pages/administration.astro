---
import Layout from '../layouts/Layout.astro';
import '../styles/administration.css';
import PageHead from '../components/PageHead.astro';
import Avatar from '../components/Avatar.astro';
import AppointmentDialog from '../components/AppointmentDialog.astro';
import { meta, contact, administration, wards, offices, body } from '../data/site';

---
<Layout title="Who runs the municipality | Mirik Municipality">
  <PageHead slug="administration" title="Who runs the municipality" lead="Who is in charge, how the nine wards are set up, and the government offices in town." />
    <section id="administration">
      <div class="wrap">
        <article class="featured" id="administrator">
          <div class="f-photo"><img src={administration.administrator.photoLarge} alt={administration.administrator.name} width="900" height="900" /></div>
          <div class="f-text">
            <p class="eyebrow">Administrator</p>
            <h2>{administration.administrator.name}</h2>
            <p class="f-role">Sub-Divisional Officer, Mirik</p>
            <p class="f-lead">{administration.administrator.name}, is the Sub-Divisional Officer (SDO) of Mirik and, since 19 May 2026, the Administrator of the Mirik Notified Area Authority, running the civic body until a new board is elected. The Sub-Divisional Office is near Mirik Police Station, Thana Line, and is open {contact.hours}.</p>
            <h3 class="f-h">What the Administrator does</h3>
            <ul class="f-list">
              <li>Leads the authority while no elected board is in place</li>
              <li>Oversees the work of the Executive Officer and the Finance Officer</li>
              <li>Decides on works, budgets and civic services for the nine wards</li>
              <li>Also heads the Sub-Divisional Office, Mirik, which became a subdivision on 30 March 2017</li>
            </ul>
            <div class="f-btns">
              <a class="fbtn appt" data-open-apt href={`mailto:${contact.email}?subject=${encodeURIComponent('Appointment request: Administrator, Mirik')}&body=${encodeURIComponent('Name:\nPhone:\nPurpose of the meeting:\nPreferred date and time:\n')}`}>Book an appointment <svg class="fbtn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
              <a class="fbtn" href={`mailto:${contact.email}?subject=${encodeURIComponent('For the Administrator, Mirik')}`}>Email</a>
            </div>
          </div>
        </article>

        <div class="status">
          <span class="dot"></span>
          <div><strong>{administration.status}.</strong> {administration.statusNote}</div>
        </div>
        <section class="admin-body" id="officers" aria-labelledby="body-title">
          <div class="admin-body-head">
            <div>
              <p class="eyebrow">Administration</p>
              <h2 id="body-title">Mirik Municipality Body</h2>
            </div>
            <p>Meet the officers and staff contacts currently listed for the Municipality Office.</p>
          </div>
          <div class="bodygrid">
            {body.filter((member) => member.name).map((member) => (
              <article class="member" style={`--tone:${member.tone}`}>
                <Avatar name={member.name} tone={member.tone} photo={member.photo} />
                <div class="minfo">
                  <h3>{member.name}</h3>
                  <p class="role">{member.role}</p>
                  {member.note && <p class="mnote">{member.note}</p>}
                </div>
                <div class="mbtns">
                  <a class="mbtn" href={`mailto:${contact.email}?subject=${encodeURIComponent('For ' + member.role + ' ' + member.name)}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v14H4zM4 7l8 6 8-6" /></svg><span>Email</span>
                  </a>
                  <a class="mbtn call" href={`tel:${member.tel ?? contact.phones[0].tel}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg><span>Call</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <div class="grid-2" style="margin-top:40px">
          <div>
            <h3 id="wards">Wards</h3>
            <table>
              <thead><tr><th>Ward</th><th>Localities</th><th>Councillor</th></tr></thead>
              <tbody>
                {wards.map((w) => (
                  <tr>
                    <td><strong>Ward {w.no}</strong></td>
                    <td class={w.localities ? '' : 'muted'}>{w.localities || 'To be listed'}</td>
                    <td class="muted">Election pending</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <aside class="mapcard">
              <h4>Detailed map of Mirik</h4>
              <p>Block map of Mirik, Darjeeling showing tea gardens, forests, rivers and administrative boundaries. It does not mark the nine municipal ward boundaries.</p>
              <a class="btn solid dark" href="https://www.scribd.com/doc/142758278/MIRIK-Darjeeling" target="_blank" rel="noopener">Open detailed map <span aria-hidden="true">&rarr;</span></a>
            </aside>
          </div>
          <div>
            <h3 id="jurisdiction">Jurisdiction</h3>
            <dl class="kv">
              <dt>Body</dt><dd>{meta.legalName}</dd>
              <dt>Wards</dt><dd>{administration.wards}</dd>
              <dt>Last election</dt><dd>{administration.lastElection}</dd>
              <dt>Subdivision</dt><dd>{administration.subdivision}</dd>
              <dt>District</dt><dd>{meta.district}, {meta.state}</dd>
              <dt>Assembly seat</dt><dd>{administration.assembly}</dd>
              <dt>Lok Sabha seat</dt><dd>{administration.loksabha}</dd>
            </dl>
          </div>
        </div>
        <section class="office-directory" aria-labelledby="offices">
          <div class="office-directory-head">
            <p class="eyebrow">Public offices</p>
            <h2 id="offices">Other government offices in Mirik</h2>
          </div>
          <ul class="offices">
            {offices.map((o) => (
              <li>
                <div class="thumb">
                  {o.photo
                    ? <img src={o.photo} alt={`${o.name}`} width="800" height="600" loading="lazy" />
                    : <iframe title={`Map: ${o.name}`} src={`https://www.google.com/maps?q=${encodeURIComponent(o.name + ', ' + o.address)}&z=16&output=embed`} loading="lazy" tabindex="-1" referrerpolicy="no-referrer-when-downgrade"></iframe>}
                </div>
                <div class="obody">
                  <strong>{o.name}</strong>
                  <small>{o.detail}</small>
                  <address>{o.address}</address>
                  <a class="dir" href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(o.name + ', ' + o.address)}`} target="_blank" rel="noopener">Get directions <span aria-hidden="true">&rarr;</span></a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </section>
  <AppointmentDialog />
</Layout>
