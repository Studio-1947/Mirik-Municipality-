};

// Page-only presentation for notices: category, icon and a related link, keyed by the notice title in site.ts.
// Kept here (not in site.ts) because the home page also lists notices from site.ts.
const cats: Record<string, { label: string; icon: string }> = {
  clean: { label: 'Cleanliness', icon: ni.clean },
  admin: { label: 'Administration', icon: ni.admin },
  works: { label: 'Projects and works', icon: ni.works },
  general: { label: 'Notice', icon: ni.general },
};
const extra: Record<string, { cat: string; href?: string; cta?: string }> = {
  'Strict cleanliness rules now in force, with fines': { cat: 'clean', href: '/clean-mirik/#fines', cta: 'See the fine list' },
  'Board dissolved; SDO Mirik appointed Administrator': { cat: 'admin', href: '/administration/', cta: 'See the Administration page' },
  'Two new sewage treatment plants announced': { cat: 'works', href: '#projects', cta: 'See the lake project' },
  'AMRUT 2.0 drinking water project': { cat: 'works', href: '#amrut', cta: 'Read about AMRUT 2.0' },
};

const months = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
// "1 September 2026" -> Date; anything else (e.g. "Ongoing") -> null.
const parseDate = (s: string) => {
  const m = s.trim().match(/^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/);
  const mi = m ? months.indexOf(m[2].toLowerCase()) : -1;
  return m && mi >= 0 ? new Date(Date.UTC(+m[3], mi, +m[1])) : null;
};
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const board = notices.map((n) => {
  const x = extra[n.title] ?? { cat: 'general' };
  const d = parseDate(n.date);
  return { ...n, ...x, cat: cats[x.cat] ? x.cat : 'general', when: d, iso: d?.toISOString().slice(0, 10), id: `notice-${slug(n.title)}` };
});
const dated = board.filter((n) => n.when).sort((a, b) => b.when!.getTime() - a.when!.getTime());
const ongoing = board.filter((n) => !n.when);
const latest = dated[0];
const earlier = dated.slice(1);
const years = [...new Set(earlier.map((n) => n.when!.getUTCFullYear()))];
const ext = (href: string) => /^https?:/.test(href);
// Project card -> its case study page (matched by title).
const study = (title: string) => caseStudies.find((c) => c.project === title);
// Visual context for the schemes showcase. Local images keep the section fast and reliable;
// the PMAY-U image is from the official programme gallery (see public/images/ATTRIBUTIONS.md).
const schemeVisuals: Record<string, { image: string; alt: string; pos?: string }> = {
  amrut: { image: '/images/projects/piped-water.jpg', alt: 'Water tanker on a Darjeeling street', pos: 'center 60%' },
  sbm: { image: '/images/projects/sumendu-lake.jpg', alt: 'Sumendu Lake in Mirik', pos: 'center 55%' },
  nulm: { image: '/images/tea.jpg', alt: 'Tea gardens in the Mirik hills' },
  pmay: { image: '/images/schemes/pmay-urban-udaipur.jpg', alt: 'PMAY Urban affordable housing complex in Udaipur' },
  cbphcs: { image: '/images/health-mirik-rural-hospital.jpg', alt: 'Mirik Rural Hospital' },
};
const schemeDetailSlug: Record<string, string> = {
  sbm: 'swachh-bharat-mission',
  nulm: 'urban-livelihoods-mission',
  pmay: 'housing-for-all',
  cbphcs: 'community-health-care',
};
---
<Layout title="Notices | Mirik Municipality">
  <PageHead slug="notices" title="Notice board" lead="Official announcements from the Municipality Office." />
  <section id="notices" class="notices-page nb-sec">
    <div class="wrap nb-grid">
      <div class="nb-main">
        {latest && (
          <article class={`nb-feature cat-${latest.cat} nb-o1`} id={latest.id}>
            <svg class="nb-mark" viewBox="0 0 24 24" aria-hidden="true" set:html={cats[latest.cat].icon} />
            <div class="nb-meta">
              <span class="nb-latest"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.latest} />Latest</span>
              <span class="nb-cat"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={cats[latest.cat].icon} />{cats[latest.cat].label}</span>
              <time class="nb-date" datetime={latest.iso}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.calendar} />{latest.date}</time>
            </div>
            <h2>{latest.title}</h2>
            <p>{latest.body}</p>
            {latest.href && (
              <div class="nb-actions">
                <a class="nb-btn" href={latest.href} target={ext(latest.href) ? '_blank' : undefined} rel={ext(latest.href) ? 'noopener' : undefined}>
                  <span>{latest.cta}</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.arrow} />
                </a>
              </div>
            )}
          </article>
        )}

        {earlier.length > 0 && (
          <div class="nb-earlier nb-o3">
            <h2 class="nb-h">Earlier notices</h2>
            {years.map((y) => (
              <div class="nb-year">
                <p class="nb-year-label">{y}</p>
                <ol class="nb-timeline">
                  {earlier.filter((n) => n.when!.getUTCFullYear() === y).map((n) => (
                    <li class={`nb-item cat-${n.cat}`} id={n.id}>
                      <span class="nb-node" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={cats[n.cat].icon} /></span>
                      <article class="nb-card">
                        <div class="nb-meta">
                          <time class="nb-date" datetime={n.iso}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.calendar} />{n.date}</time>
                          <span class="nb-cat">{cats[n.cat].label}</span>
                        </div>
                        <h3>{n.title}</h3>
                        <p>{n.body}</p>
                        {n.href && (
                          <div class="nb-actions">
                            <a class="nb-link" href={n.href} target={ext(n.href) ? '_blank' : undefined} rel={ext(n.href) ? 'noopener' : undefined}>
                              <span>{n.cta}</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.arrow} />
                            </a>
                          </div>
                        )}
                      </article>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        )}
      </div>

      <aside class="nb-side">
        {ongoing.length > 0 && (
          <div class="nb-ongoing nb-o2">
            <p class="nb-live"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.ongoing} />Ongoing</p>
            {ongoing.map((n) => (
              <article class={`nb-on cat-${n.cat}`} id={n.id}>
                <span class="nb-cat">{cats[n.cat].label}</span>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
                {n.href && (
                  <a class="nb-link" href={n.href}><span>{n.cta}</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.arrow} /></a>
                )}
              </article>
            ))}
          </div>
        )}
        <div class="nb-follow nb-o4">
          <span class="nb-follow-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.megaphone} /></span>
          <h3>Stay informed</h3>
          <p>Notices are also shared on the Facebook page of the municipality.</p>
          <a class="nb-fb" href={contact.facebook} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.facebook} /><span>Follow on Facebook</span></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="alt" id="projects">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Projects</p>
        <h2>Projects under way</h2>
        <p class="lead">Water, sanitation, housing and health schemes being delivered in Mirik.</p>
      </div>
      <div class="pj-grid">
        {projects.map((p) => {
          const cs = study(p.title);
          return (
            <article class={`pj-card tone-${cs?.tone ?? 'lake'}`}>
              <figure class="pj-media">
                {cs?.photo
                  ? <img src={cs.photo.src} alt={cs.photo.alt} width="1400" height="930" loading="lazy" style={`object-position:${cs.photo.pos ?? 'center'}`} />
                  : <span class="pj-noimg" aria-hidden="true"></span>}
                {cs && <span class="pj-status"><i aria-hidden="true"></i>{cs.status}</span>}
                <span class="pj-figure">{p.figure}</span>
              </figure>
              <div class="pj-body">
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                {cs && (
                  <a class="pj-go" href={`/notices/projects/${cs.slug}/`}>
                    <span>Read the case study</span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ni.arrow} />
                  </a>
                )}
              </div>
              {cs?.photo && (
                <p class="pj-credit"><span>Photo</span>: <a href={cs.photo.url} target="_blank" rel="noopener">{cs.photo.credit}</a>, <a href={cs.photo.licenseUrl} target="_blank" rel="noopener">{cs.photo.license}</a></p>
              )}
            </article>
          );
        })}
      </div>

      <div class="scheme-head">
        <div>
          <p class="eyebrow">Programmes and schemes</p>
          <h3 id="schemes">Special projects and schemes</h3>
        </div>
        <p>National missions and local action for better everyday services in Mirik.</p>
      </div>
      <section class="scheme-feature" aria-label="Featured programme">
        <div class="scheme-feature-copy">
          <p class="scheme-kicker">Featured programme</p>
          <h4>AMRUT 2.0</h4>
          <p class="scheme-full-name">Atal Mission for Rejuvenation and Urban Transformation</p>
          <p>{schemes[0].text}</p>
          <dl class="scheme-facts">
            <div><dt>Rs 199 crore</dt><dd>Water supply project approved for Mirik</dd></div>
            <div><dt>135 litres</dt><dd>Daily water-supply target per resident</dd></div>
          </dl>
          <a class="scheme-project-link" href="/notices/projects/piped-water/">Read the project overview <span aria-hidden="true">→</span></a>
        </div>
        <figure class="scheme-feature-image">
          <img src={schemeVisuals.amrut.image} alt={schemeVisuals.amrut.alt} style={`object-position:${schemeVisuals.amrut.pos}`} />
          <figcaption>Water supply in the Darjeeling hills</figcaption>
        </figure>
      </section>
      <div class="schemes scheme-directory">
        {schemes.slice(1).map((s) => {
          const visual = schemeVisuals[s.id];
          return (
            <article id={s.id} class={`scheme-directory-card scheme-${s.id}`}>
              <figure>
                <img src={visual.image} alt={visual.alt} loading="lazy" style={visual.pos ? `object-position:${visual.pos}` : undefined} />
              </figure>
              <div>
                <p class="scheme-kicker">{s.short}</p>
                <h4>{s.name}</h4>
                <p>{s.text}</p>
                <a class="scheme-directory-link" href={`/notices/projects/${schemeDetailSlug[s.id]}/`}>Read the programme overview <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Notice board: fade cards in as they scroll into view.
  const board = document.querySelector<HTMLElement>('.nb-sec');
  if (board) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const items = Array.from(board.querySelectorAll<HTMLElement>('.nb-feature, .nb-item, .nb-ongoing, .nb-follow'));
    if (!still && 'IntersectionObserver' in window) {
      board.classList.add('nb-anim');
      const io = new IntersectionObserver((entries) => {
        entries.filter((e) => e.isIntersecting).forEach((e, n) => {
          const el = e.target as HTMLElement;
          el.style.setProperty('--d', `${n * 90}ms`);
          el.classList.add('in');
          io.unobserve(el);
        });
      }, { threshold: 0.12 });
      items.forEach((el) => io.observe(el));
    }
  }
</script>
