const statusLabel: Record<string, string> = { critical: 'Critical', progress: 'In progress', resolved: 'Resolved' };
---
<Layout title="Services & Grievances | Mirik Municipality">
  <PageHead slug="services" title="Services & Grievances" lead="How to apply for municipal services, and how to report a problem in your ward." />

  <section class="alt svc-sec" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Citizen Services</p>
        <h2>Apply online or at the office</h2>
        <p class="lead">Most municipal services in West Bengal run on state portals. Use the links below from anywhere, or visit the office at Thana Line.</p>
      </div>
      <div class="svc-grid">
        {services.map((s) => {
          const l = look[s.title] ?? fallback;
          const href = s.link || '/contact/';
          const ext = isExternal(href);
          return (
            <article class={`svc-card tone-${l.tone}`}>
              <svg class="svc-mark" viewBox="0 0 24 24" aria-hidden="true" set:html={l.icon} />
              <div class="svc-top">
                <span class="svc-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={l.icon} /></span>
                <span class={s.online ? 'svc-tag on' : 'svc-tag'}><i aria-hidden="true"></i>{s.online ? 'Online' : 'At the office'}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a class={s.title === 'Birth and Death Registration' ? 'svc-go is-long' : 'svc-go'} href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                <span>{s.link ? s.linkLabel : 'Office address and hours'}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ext ? arrow.out : arrow.in} />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="grievances">
    <div class="wrap">
      <div class="grvx-top">
        <div class="section-head">
          <p class="eyebrow grvx-eyebrow"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.pulse} />Grievances</p>
          <h2>Report a problem in your ward</h2>
          <p class="lead">Tell the Municipality Office what is wrong and where. A clear location and a photo help the office act quickly.</p>
        </div>
        <ul class="grvx-stats">
          {demoStats.map((s) => (
            <li class={`grvx-stat tone-${s.tone}`}>
              <span class="grvx-stat-h"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} /><span>{s.label}</span></span>
              <b>{s.value}{s.unit && <small>{s.unit}</small>}</b>
            </li>
          ))}
        </ul>
      </div>
      <p class="grvx-demo-note"><span class="grvx-demo-badge">Demo data</span><span>The online grievance system is not live yet, so the figures and cases below are examples, not real reports.</span></p>

      <div class="grvx-grid">
        <div class="grvx-main">
          <div class="grvx-panel grvx-overview o-2">
            <div class="grvx-ov-head">
              <div>
                <h3><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.pulse} />Grievance overview</h3>
                <p>Cases by category and local conditions</p>
              </div>
              <div class="grvx-select">
                <select aria-label="Time period" data-period-select>
                  {demoPeriods.map((p) => <option value={p.id}>{p.label}</option>)}
                </select>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.chevron} />
              </div>
            </div>
            {demoPeriods.map((p, i) => (
              <div class="grvx-breakdown" data-period={p.id} hidden={i !== 0}>
                <div class="grvx-donut-col">
                  <p class="grvx-mini">Issue categories</p>
                  <div class="grvx-donut" style={`--ring: conic-gradient(${p.ring})`}>
                    <div><b>{p.total}</b><small>Total cases</small></div>
                  </div>
                </div>
                <ul class="grvx-bars">
                  {p.cats.map((c) => (
                    <li class={`tone-${c.tone}`} style={`--w:${c.w}%`}>
                      <div class="grvx-bar-row">
                        <span class="grvx-dot" aria-hidden="true"></span>
                        <span class="grvx-bar-l">{c.label}</span>
                        <b>{c.n}</b>
                        <em class={`grvx-trend ${c.dir}`}>{c.trend}</em>
                      </div>
                      <div class="grvx-bar" aria-hidden="true"><i></i></div>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="grvx-cond">
              <div class="grvx-cond-head">
                <p class="grvx-mini">Local conditions</p>
                <span class="grvx-live"><span class="grvx-live-dots" aria-hidden="true"><i></i><i></i><i></i></span>Active monitoring</span>
              </div>
              <ul class="grvx-cond-grid">
                {demoConditions.map((c) => (
                  <li class={`tone-${c.tone}`} style={`--w:${c.value}%`}>
                    <div class="grvx-cond-top">
                      <span class="grvx-cond-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={c.icon} /></span>
                      <b>{c.value}%</b>
                    </div>
                    <strong>{c.label}</strong>
                    <small>{c.note}</small>
                    <div class="grvx-bar" aria-hidden="true"><i></i></div>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="grvx-cases o-5">
            <div class="grvx-panel grvx-filter">
              <label class="grvx-search">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.search} />
                <input type="search" placeholder="Search by keyword, ward or case ID" aria-label="Search by keyword, ward or case ID" data-case-search />
              </label>
              <p class="grvx-filter-heading">Few Important issues that we are currently working on</p>
            </div>
            <ul class="grvx-case-list">
              {demoCases.map((c) => (
                <li class={`grvx-panel grvx-case s-${c.status}`} data-status={c.status}>
                  <div class="grvx-case-top">
                    <span class="grvx-case-id"><i aria-hidden="true"></i>{c.id}</span>
                    <span class="grvx-status">{statusLabel[c.status]}</span>
                    <span class="grvx-case-meta">
                      <span><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.calendar} /><span>{c.ago}</span> <span>{c.unit}</span></span>
                      <span class="grvx-case-ward"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.location} /><span>Ward</span> <span>{c.ward}</span></span>
                    </span>
                  </div>
                  <div class="grvx-case-body">
                    <div>
                      <p class="grvx-mini">Issue description</p>
                      <blockquote>{c.text}</blockquote>
                    </div>
                    <div class="grvx-esc">
                      <p class="grvx-mini">Escalation status</p>
                      <dl>
                        <div><dt>Assigned</dt><dd>{c.team}</dd></div>
                        <div><dt>Priority</dt><dd class={`p-${c.priority.toLowerCase()}`}>{c.priority}</dd></div>
                      </dl>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="grvx-empty" hidden>No cases match your search.</p>
          </div>

        </div>
        <aside class="grvx-side">
          <div class="grvx-cta o-1">
            <span class="grvx-cta-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.flash} /></span>
            <h3>Report a new issue</h3>
            <p>Give your ward and the exact location, and attach a photo if you can.</p>
            <a class="grvx-btn" href="/grievance/">Submit grievance</a>
          </div>
          <div class="grvx-panel grvx-rank o-3">
            <h3 class="grvx-side-h"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.award} />Ward response ranking</h3>
            <p class="grvx-side-sub">Cases resolved on time</p>
            <ol class="grvx-rank-list">
              {demoRanking.map((r, i) => (
                <li hidden={i > 2}>
                  <span class="grvx-rank-n">#{i + 1}</span>
                  <div class="grvx-rank-w"><strong><span>Ward</span> <span>{r.no}</span></strong>{r.short && <small>{r.short}</small>}</div>
                  <div class="grvx-rank-v"><b>{r.pct}%</b><small><span>{r.days}</span> <span>days</span></small></div>
                </li>
              ))}
            </ol>
            <button type="button" class="grvx-more" aria-expanded="false"><span>View all wards</span><span hidden>Show fewer</span></button>
          </div>
          <div class="grvx-panel grvx-insights o-4">
            <h3 class="grvx-side-h"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.layers} />Quick insights</h3>
            <div class="grvx-ins"><small>Most reported</small><strong>{demoPeriods[0].cats[0].label}</strong></div>
            <div class="grvx-ins"><small>Fastest ward</small><strong><span>Ward</span> <span>{demoRanking[0].no}</span></strong>{demoRanking[0].short && <em>{demoRanking[0].short}</em>}</div>
          </div>
          <div class="grvx-panel grvx-reach o-8">
            <h3>Other ways to reach the office</h3>
            <ul class="grvx-contacts">
              {contact.phones.map((p) => (
                <li><span class="grvx-ci"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.call} /></span><div><small>{p.label}</small><a href={`tel:${p.tel}`}>{p.display}</a></div></li>
              ))}
              <li><span class="grvx-ci"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.mail} /></span><div><small>Email</small><a href={`mailto:${contact.email}`}>{contact.email}</a></div></li>
              <li><span class="grvx-ci"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.facebook} /></span><div><small>Facebook</small><a href={contact.facebook} target="_blank" rel="noopener">{fbLabel}</a></div></li>
              <li><span class="grvx-ci"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={gi.clock} /></span><div><small>Office hours</small><span>{contact.hours}</span></div></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Service cards: fade up one after another when scrolled into view, and a soft glow that follows the pointer.
  const grid = document.querySelector<HTMLElement>('.svc-grid');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.svc-card')) : [];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid && !still && 'IntersectionObserver' in window) {
    grid.classList.add('svc-anim');
    const io = new IntersectionObserver((entries) => {
      // Stagger only the cards that arrive together, so later rows don't wait for earlier ones.
      entries.filter((e) => e.isIntersecting).forEach((e, n) => {
        const c = e.target as HTMLElement;
        c.style.setProperty('--d', `${n * 80}ms`);
        c.classList.add('in');
        io.unobserve(c);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    cards.forEach((c) => io.observe(c));
  }

  if (!still && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    cards.forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--mx', `${e.clientX - r.left}px`);
        c.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }

  // Grievance dashboard (demo data).
  const overview = document.querySelector<HTMLElement>('.grvx-overview');
  if (overview) {
    // Bars grow in when the panel first scrolls into view.
    if (!still && 'IntersectionObserver' in window) {
      overview.classList.add('grvx-anim');
      const io = new IntersectionObserver((entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        overview.classList.add('in');
        io.disconnect();
      }, { threshold: 0.2 });
      io.observe(overview);
    }
    // Time period switch: show the matching breakdown.
    overview.querySelector<HTMLSelectElement>('[data-period-select]')?.addEventListener('change', (e) => {
      const id = (e.target as HTMLSelectElement).value;
      overview.querySelectorAll<HTMLElement>('[data-period]').forEach((b) => { b.hidden = b.dataset.period !== id; });
    });
  }

  // Case list search.
  const cases = document.querySelector<HTMLElement>('.grvx-cases');
  if (cases) {
    const rows = Array.from(cases.querySelectorAll<HTMLElement>('.grvx-case'));
    const search = cases.querySelector<HTMLInputElement>('[data-case-search]');
    const empty = cases.querySelector<HTMLElement>('.grvx-empty');
    const apply = () => {
      const q = (search?.value ?? '').trim().toLowerCase();
      let shown = 0;
      rows.forEach((r) => {
        const ok = !q || (r.textContent ?? '').toLowerCase().includes(q);
        r.hidden = !ok;
        if (ok) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    };
    search?.addEventListener('input', apply);
  }

  // Ward ranking: show all wards or only the top three.
  document.querySelectorAll<HTMLButtonElement>('.grvx-more').forEach((btn) => {
    const extra = Array.from(btn.parentElement?.querySelectorAll<HTMLElement>('.grvx-rank-list li') ?? []).slice(3);
    const [more, less] = Array.from(btn.children) as HTMLElement[];
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      extra.forEach((li) => { li.hidden = !open; });
      btn.setAttribute('aria-expanded', String(open));
      if (more && less) { more.hidden = open; less.hidden = !open; }
    });
  });
</script>
