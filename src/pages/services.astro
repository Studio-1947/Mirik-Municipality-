const isExternal = (href: string) => !(href.startsWith('/') || href.startsWith('#'));

// FAQ. Keep the English text exact: it is the translation key in i18n.ts.
const faqs = [
  { q: 'How do I apply for a trade licence?', a: 'Apply online on the state e-District portal. You register first with your mobile number and an OTP. Renewals are done there too.' },
  { q: 'How do I register a birth or death?', a: 'Use the state Janma-Mrityu Tathya portal. Once the record is registered, you can download the certificate online.' },
  { q: 'Where do I submit a building plan?', a: 'Building plans are submitted and tracked on the state Online Building Permission System (OBPS).' },
  { q: 'How do I apply for a mutation?', a: 'Apply at the Municipality Office. Take your holding number and the papers that show who owns the property.' },
  { q: 'How do I pay holding tax?', a: 'Holding tax is assessed and paid through the Municipality Office. Take your holding number with you.' },
  { q: 'How do I report a problem in my ward?', a: 'Use the Grievance button at the top of any page, or email or call the office. Give your ward and the exact location so the office can act quickly.' },
  { q: 'When is the office open?', a: 'Monday to Friday, 10:00 AM to 5:30 PM. The office is closed on government holidays.' },
  { q: 'Who do I call in an emergency?', a: 'Dial 112 for any emergency. Police is 100, fire is 101 and ambulance is 108. The Emergency page lists more numbers.' },
];
const chevron = '<path d="M18 9.00005C18 9.00005 13.5811 15 12 15C10.4188 15 6 9 6 9"/>'; // Hugeicons ArrowDown01Icon
---
<Layout title="Services & Grievances | Mirik Municipality">
  <PageHead slug="services" title="Services & Grievances" lead="How to apply for municipal services, and how to report a problem in your ward." />

  <section class="alt svc-sec" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Citizen Services</p>
        <h2>Apply online or at the office</h2>
        <p class="lead">Most municipal services in West Bengal run on state portals. Use the links below from anywhere, or visit the office at Thana Line.</p>
      </div>
      <div class="svc-grid">
        {services.map((s) => {
          const l = look[s.title] ?? fallback;
          const href = s.link || '/contact/';
          const ext = isExternal(href);
          return (
            <article class={`svc-card tone-${l.tone}`}>
              <svg class="svc-mark" viewBox="0 0 24 24" aria-hidden="true" set:html={l.icon} />
              <div class="svc-top">
                <span class="svc-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={l.icon} /></span>
                <span class={s.online ? 'svc-tag on' : 'svc-tag'}><i aria-hidden="true"></i>{s.online ? 'Online' : 'At the office'}</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a class="svc-go" href={href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                <span>{s.link ? s.linkLabel : 'Office address and hours'}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ext ? arrow.out : arrow.in} />
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section id="faq">
    <div class="wrap faqx">
      <div class="faqx-main">
        <div class="section-head">
          <p class="eyebrow">FAQ</p>
          <h2>Common questions</h2>
          <p class="lead">Quick answers about applying, paying and getting help.</p>
        </div>
        <div class="faqx-list">
          {faqs.map((f, i) => (
            <div class="faqx-item">
              <h3 class="faqx-q">
                <button type="button" id={`faq-q-${i}`} aria-expanded="true" aria-controls={`faq-a-${i}`}>
                  <span>{f.q}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={chevron} />
                </button>
              </h3>
              <div class="faqx-a" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`}>
                <div><p>{f.a}</p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Service cards: fade up one after another when scrolled into view, and a soft glow that follows the pointer.
  const grid = document.querySelector<HTMLElement>('.svc-grid');
  const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.svc-card')) : [];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid && !still && 'IntersectionObserver' in window) {
    grid.classList.add('svc-anim');
    const io = new IntersectionObserver((entries) => {
      // Stagger only the cards that arrive together, so later rows don't wait for earlier ones.
      entries.filter((e) => e.isIntersecting).forEach((e, n) => {
        const c = e.target as HTMLElement;
        c.style.setProperty('--d', `${n * 80}ms`);
        c.classList.add('in');
        io.unobserve(c);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    cards.forEach((c) => io.observe(c));
  }

  if (!still && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    cards.forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--mx', `${e.clientX - r.left}px`);
        c.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }

  // FAQ accordion: one answer open at a time. Without JS every answer stays visible.
  const faqList = document.querySelector<HTMLElement>('.faqx-list');
  if (faqList) {
    const items = Array.from(faqList.querySelectorAll<HTMLElement>('.faqx-item'));
    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('open', open);
      item.querySelector('button')?.setAttribute('aria-expanded', String(open));
    };
    items.forEach((item) => setOpen(item, false));
    faqList.classList.add('faqx-js');
    items.forEach((item) => {
      item.querySelector('button')?.addEventListener('click', () => {
        const open = !item.classList.contains('open');
        items.forEach((other) => setOpen(other, other === item && open));
      });
    });
  }
</script>
