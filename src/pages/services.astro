---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { services, projects, schemes } from '../data/site';
---
<Layout title="Services and Projects | Mirik Municipality">
  <PageHead slug="services" title="Services and Projects" lead="How to apply for municipal services, and the water, sanitation and housing projects under way in Mirik." />

  <section class="alt" id="services">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Citizen Services</p>
        <h2>Apply online or at the office</h2>
        <p class="lead">Most municipal services in West Bengal run on state portals. Use the links below from anywhere, or visit the office at Thana Line.</p>
      </div>
      <div class="cards">
        {services.map((s) => (
          <article class="card">
            <span class={s.online ? 'tag' : 'tag office'}>{s.online ? 'Online' : 'At the office'}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.link && (
              <a class="go" href={s.link} target={s.link.startsWith('/') || s.link.startsWith('#') ? undefined : '_blank'} rel="noopener">{s.linkLabel}</a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Projects</p>
        <h2>Projects under way</h2>
        <p class="lead">Water, sanitation, housing and health schemes being delivered in Mirik.</p>
      </div>
      <div class="grid-3">
        {projects.map((p) => (
          <article class="card project">
            <div class="figure">{p.figure}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>

      <h3 id="schemes" style="margin-top:48px">Special projects and schemes</h3>
      <div class="schemes">
        {schemes.map((s, i) => (
          <details id={s.id} open={i === 0}>
            <summary>{s.short} <span>{s.name}</span></summary>
            <div class="body"><p>{s.text}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <section class="alt" id="faq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Common questions</h2>
        <p class="lead">Quick answers about applying, paying and getting help.</p>
      </div>
      <div class="schemes faq">
        <details><summary>How do I apply for a trade licence?</summary><div class="body"><p>Apply online on the state e-District portal. You register first with your mobile number and an OTP. Renewals are done there too.</p></div></details>
        <details><summary>How do I register a birth or death?</summary><div class="body"><p>Use the state Janma-Mrityu Tathya portal. Once the record is registered, you can download the certificate online.</p></div></details>
        <details><summary>Where do I submit a building plan?</summary><div class="body"><p>Building plans are submitted and tracked on the state Online Building Permission System (OBPS).</p></div></details>
        <details><summary>How do I apply for a mutation?</summary><div class="body"><p>Apply at the Municipality Office. Take your holding number and the papers that show who owns the property.</p></div></details>
        <details><summary>How do I pay holding tax?</summary><div class="body"><p>Holding tax is assessed and paid through the Municipality Office. Take your holding number with you.</p></div></details>
        <details><summary>How do I report a problem in my ward?</summary><div class="body"><p>Use the Grievance button at the top of any page, or email or call the office. Give your ward and the exact location so the office can act quickly.</p></div></details>
        <details><summary>When is the office open?</summary><div class="body"><p>Monday to Friday, 10:00 AM to 5:30 PM. The office is closed on government holidays.</p></div></details>
        <details><summary>Who do I call in an emergency?</summary><div class="body"><p>Dial 112 for any emergency. Police is 100, fire is 101 and ambulance is 108. The Emergency page lists more numbers.</p></div></details>
      </div>
    </div>
  </section>
</Layout>
