---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import { emergency } from '../data/site';
---
<Layout title="Helplines | Mirik Municipality">
  <PageHead slug="emergency" title="Helplines" lead="During heavy rain and landslide alerts, follow instructions from the Sub-Divisional Office and avoid unnecessary travel on hill roads." />
    <section class="alt" id="emergency">
      <div class="wrap">
        <div class="sos">
          {emergency.map((e) => <a href={`tel:${e.number}`}><b>{e.number}</b><span>{e.label}</span></a>)}
        </div>
      </div>
    </section>
  <section class="alt" id="safety">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Safety</p>
        <h2>Staying safe in heavy rain</h2>
        <p class="lead">Landslides are a real risk in the hills during the monsoon. These simple habits help.</p>
      </div>
      <ul class="tips">
          <li>Avoid hill roads at night and during heavy rain.</li>
          <li>Stay away from steep slopes, streams and drains when it rains hard.</li>
          <li>Do not park or camp under loose slopes or beside swollen streams.</li>
          <li>Keep your phone charged and the numbers on this page saved.</li>
          <li>Follow the instructions of the Sub-Divisional Office and local authorities.</li>
          <li>Tell the Municipality Office about cracks in the ground, blocked drains or fallen trees.</li>
      </ul>
    </div>
  </section>
</Layout>
